---
interface Props {
	size?: 'hero' | 'compact';
	class?: string;
}

const { size = 'hero', class: className } = Astro.props;
---

<div
	class:list={['gateway-compass', size === 'compact' && 'gateway-compass--compact', className]}
	aria-hidden="true"
	data-gateway-compass={size === 'hero' ? '' : undefined}
>
	<div class="gateway-compass__glow"></div>
	<div class="gateway-compass__corona"></div>
	<div class="gateway-compass__pulse"></div>
	<div class="gateway-compass__pulse gateway-compass__pulse--b"></div>
	<div class="gateway-compass__frame">
		<svg class="gateway-compass__svg" viewBox="0 0 200 200" fill="none" aria-hidden="true">
			<circle cx="100" cy="100" r="94" stroke="rgba(212, 184, 122, 0.32)" stroke-width="2" />
			<circle cx="100" cy="100" r="88" stroke="rgba(201, 169, 98, 0.5)" stroke-width="1.5" />
			<circle cx="100" cy="100" r="82" fill="rgba(14, 26, 46, 0.92)" stroke="rgba(212, 184, 122, 0.22)" stroke-width="1" />

			<g class="gateway-compass__ticks" stroke="rgba(212, 184, 122, 0.38)" stroke-width="1">
				{
					Array.from({ length: 72 }, (_, i) => {
						const angle = (i * 360) / 72;
						const rad = (angle * Math.PI) / 180;
						const inner = i % 6 === 0 ? 76 : i % 2 === 0 ? 80 : 83;
						const outer = 88;
						const x1 = 100 + inner * Math.sin(rad);
						const y1 = 100 - inner * Math.cos(rad);
						const x2 = 100 + outer * Math.sin(rad);
						const y2 = 100 - outer * Math.cos(rad);
						return (
							<line
								x1={x1.toFixed(2)}
								y1={y1.toFixed(2)}
								x2={x2.toFixed(2)}
								y2={y2.toFixed(2)}
								stroke-width={i % 6 === 0 ? 1.25 : 0.75}
								opacity={i % 6 === 0 ? 0.85 : 0.45}
							/>
						);
					})
				}
			</g>

			<g class="gateway-compass__rose" stroke="rgba(212, 184, 122, 0.28)" stroke-width="0.75" fill="none">
				<circle cx="100" cy="100" r="58" />
				<circle cx="100" cy="100" r="42" stroke-dasharray="2 6" opacity="0.65" />
				<line x1="100" y1="42" x2="100" y2="158" />
				<line x1="42" y1="100" x2="158" y2="100" />
				<line x1="59" y1="59" x2="141" y2="141" opacity="0.55" />
				<line x1="141" y1="59" x2="59" y2="141" opacity="0.55" />
			</g>

			<g
				class="gateway-compass__needle"
				fill="rgba(234, 229, 221, 0.85)"
				stroke="rgba(212, 184, 122, 0.55)"
				stroke-width="0.75"
				stroke-linejoin="round"
			>
				<path d="M100 38 L108 100 L100 92 Z" fill="rgba(201, 169, 98, 0.95)" stroke="rgba(212, 184, 122, 0.5)" />
				<path d="M100 162 L92 100 L100 108 Z" fill="rgba(234, 229, 221, 0.35)" />
				<circle cx="100" cy="100" r="5.5" fill="rgba(18, 32, 56, 0.95)" stroke="rgba(201, 169, 98, 0.65)" stroke-width="1.25" />
				<circle cx="100" cy="100" r="2" fill="rgba(201, 169, 98, 0.85)" />
			</g>

			<g
				class="gateway-compass__labels"
				fill="rgba(234, 229, 221, 0.78)"
				font-family="Cormorant Garamond, Georgia, serif"
				font-size="13"
				font-style="italic"
				text-anchor="middle"
			>
				<text x="100" y="56" font-weight="600">N</text>
				<text x="148" y="104">E</text>
				<text x="100" y="152" opacity="0.75">S</text>
				<text x="52" y="104">W</text>
			</g>
		</svg>
	</div>
	<div class="gateway-compass__ring gateway-compass__ring--a"></div>
	<div class="gateway-compass__ring gateway-compass__ring--b"></div>
</div>

<style>
	.gateway-compass {
		--compass-size: 12rem;
		position: relative;
		width: var(--compass-size);
		height: var(--compass-size);
	}

	.gateway-compass--compact {
		--compass-size: 1.65rem;
	}

	.gateway-compass__glow {
		position: absolute;
		inset: -28%;
		border-radius: 9999px;
		background:
			radial-gradient(circle, rgba(255, 220, 160, 0.35) 0%, rgba(201, 148, 58, 0.12) 42%, transparent 68%);
		animation: gateway-compass-glow 4s ease-in-out infinite alternate;
		pointer-events: none;
	}

	.gateway-compass__corona {
		position: absolute;
		inset: -18%;
		border-radius: 9999px;
		border: 1px solid rgba(201, 148, 58, 0.22);
		box-shadow:
			0 0 24px rgba(255, 220, 160, 0.28),
			0 0 48px rgba(201, 148, 58, 0.14),
			inset 0 0 20px rgba(255, 248, 235, 0.25);
		animation: gateway-compass-corona 3.6s ease-in-out infinite;
		pointer-events: none;
	}

	.gateway-compass__pulse {
		position: absolute;
		inset: -4%;
		border-radius: 9999px;
		border: 1px solid rgba(201, 148, 58, 0.45);
		box-shadow: 0 0 18px rgba(201, 148, 58, 0.25);
		animation: gateway-compass-pulse 3.2s ease-out infinite;
		pointer-events: none;
	}

	.gateway-compass__pulse--b {
		animation-delay: 1.6s;
	}

	.gateway-compass--compact .gateway-compass__glow,
	.gateway-compass--compact .gateway-compass__corona,
	.gateway-compass--compact .gateway-compass__pulse,
	.gateway-compass--compact .gateway-compass__ring {
		display: none;
	}

	.gateway-compass__frame {
		position: relative;
		z-index: 1;
		width: 100%;
		height: 100%;
		border-radius: 9999px;
		box-shadow:
			0 0 0 1px rgba(201, 169, 98, 0.35),
			0 0 20px rgba(201, 148, 58, 0.28),
			0 8px 28px rgba(0, 0, 0, 0.45),
			inset 0 2px 8px rgba(212, 184, 122, 0.12),
			inset 0 -3px 10px rgba(0, 0, 0, 0.35);
		animation:
			gateway-compass-float 6s ease-in-out infinite,
			gateway-compass-frame-glow 3.6s ease-in-out infinite;
	}

	.gateway-compass__svg {
		display: block;
		width: 100%;
		height: 100%;
	}

	.gateway-compass__needle {
		transform-origin: 100px 100px;
		animation: gateway-compass-needle 7s ease-in-out infinite;
		filter: drop-shadow(0 0 4px rgba(201, 148, 58, 0.35));
	}

	.gateway-compass__ring {
		position: absolute;
		top: 50%;
		left: 50%;
		border-radius: 9999px;
		border: 1px dashed rgba(201, 148, 58, 0.22);
		pointer-events: none;
	}

	.gateway-compass__ring--a {
		width: 138%;
		height: 138%;
		margin: -69% 0 0 -69%;
		animation: gateway-compass-ring 18s linear infinite;
	}

	.gateway-compass__ring--b {
		width: 162%;
		height: 162%;
		margin: -81% 0 0 -81%;
		border-style: solid;
		border-color: rgba(61, 117, 136, 0.14);
		opacity: 0.75;
		animation: gateway-compass-ring 28s linear infinite reverse;
	}

	@keyframes gateway-compass-float {
		0%,
		100% {
			transform: translateY(0) rotate(-1.5deg);
		}
		50% {
			transform: translateY(-0.35rem) rotate(1.5deg);
		}
	}

	@keyframes gateway-compass-glow {
		0%,
		100% {
			opacity: 0.55;
			transform: scale(0.94);
		}
		50% {
			opacity: 1;
			transform: scale(1.08);
		}
	}

	@keyframes gateway-compass-corona {
		0%,
		100% {
			opacity: 0.65;
			transform: scale(0.97);
			box-shadow:
				0 0 18px rgba(255, 220, 160, 0.2),
				0 0 36px rgba(201, 148, 58, 0.1),
				inset 0 0 16px rgba(255, 248, 235, 0.18);
		}
		50% {
			opacity: 1;
			transform: scale(1.03);
			box-shadow:
				0 0 32px rgba(255, 220, 160, 0.42),
				0 0 64px rgba(201, 148, 58, 0.22),
				inset 0 0 28px rgba(255, 248, 235, 0.35);
		}
	}

	@keyframes gateway-compass-pulse {
		0% {
			transform: scale(0.88);
			opacity: 0.55;
		}
		70%,
		100% {
			transform: scale(1.42);
			opacity: 0;
		}
	}

	@keyframes gateway-compass-frame-glow {
		0%,
		100% {
			box-shadow:
				0 0 0 1px rgba(201, 169, 98, 0.3),
				0 0 14px rgba(201, 148, 58, 0.2),
				0 8px 28px rgba(0, 0, 0, 0.45),
				inset 0 2px 8px rgba(212, 184, 122, 0.1),
				inset 0 -3px 10px rgba(0, 0, 0, 0.35);
		}
		50% {
			box-shadow:
				0 0 0 1px rgba(201, 169, 98, 0.45),
				0 0 28px rgba(201, 148, 58, 0.42),
				0 0 48px rgba(255, 220, 160, 0.12),
				0 8px 28px rgba(0, 0, 0, 0.45),
				inset 0 2px 8px rgba(212, 184, 122, 0.16),
				inset 0 -3px 10px rgba(0, 0, 0, 0.35);
		}
	}

	@keyframes gateway-compass-needle {
		0%,
		100% {
			transform: rotate(-4deg);
		}
		50% {
			transform: rotate(4deg);
		}
	}

	@keyframes gateway-compass-ring {
		from {
			transform: rotate(0deg);
		}
		to {
			transform: rotate(360deg);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.gateway-compass__frame,
		.gateway-compass__glow,
		.gateway-compass__corona,
		.gateway-compass__pulse,
		.gateway-compass__needle,
		.gateway-compass__ring--a,
		.gateway-compass__ring--b {
			animation: none !important;
		}

		.gateway-compass__needle {
			filter: none;
		}
	}
</style>
