---
interface Props {
	href?: string;
	sourceLabel?: string;
	title?: string;
	body?: string;
	meta?: string;
	/** When true, show a static card with coming-soon label (no link) */
	comingSoon?: boolean;
	/** Label when `comingSoon` is true (default: “Coming soon”) */
	comingSoonLabel?: string;
}

const {
	href = '#',
	sourceLabel = '',
	title = '',
	body = '',
	meta = '',
	comingSoon = false,
	comingSoonLabel = 'Coming soon'
} = Astro.props;

const cardClass =
	'group block border-l-2 border-site-gold/35 bg-site-cream-2/80 px-6 py-7 shadow-[0_8px_40px_-12px_rgba(0,0,0,0.35)] transition-colors hover:border-site-gold/45';
---

{
	comingSoon ? (
		<div class:list={[cardClass, 'cursor-default']}>
			{sourceLabel && (
				<p class="text-xs font-semibold uppercase tracking-wider text-site-gold/90">{sourceLabel}</p>
			)}
			{title && <h3 class="mt-2 font-display text-xl text-site-ink">{title}</h3>}
			<p class="workshop-card__soon mt-4 text-sm font-medium tracking-wide text-site-muted">{comingSoonLabel}</p>
		</div>
	) : (
		<a href={href} class={cardClass}>
			<p class="text-xs font-semibold uppercase tracking-wider text-site-gold/90">{sourceLabel}</p>
			<h3 class="mt-2 font-display text-xl text-site-ink">{title}</h3>
			<p class="mt-3 font-serif leading-relaxed text-site-muted">{body}</p>
			<p class="mt-4 text-sm text-site-muted">{meta}</p>
			<span class="mt-4 inline-flex items-center gap-2 text-sm font-medium text-site-gold transition group-hover:gap-3">
				Open workshop
				<span aria-hidden="true">→</span>
			</span>
		</a>
	)
}
