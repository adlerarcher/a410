---
import { EXPERIENCE_ENTRIES, type ExperienceEntry } from '../data/experience';

interface Props {
	entries?: ExperienceEntry[];
}

const entries = Astro.props.entries ?? EXPERIENCE_ENTRIES;
---

<section
	class="experience-section mx-auto max-w-3xl px-4 pb-4 pt-2 md:px-6 md:pb-8"
	aria-labelledby="experience-heading"
>
	<h2
		id="experience-heading"
		class="text-center font-display text-3xl font-semibold tracking-tight text-site-gold md:text-4xl"
	>
		Experience
	</h2>
	<div class="mx-auto mt-6 flex items-center justify-center gap-2.5 md:mt-7">
		<span class="h-px w-8 bg-gradient-to-r from-transparent to-foundation-gold/70" aria-hidden="true"></span>
		<p class="font-mono text-[10px] uppercase tracking-[0.35em] text-warm-gray/90">
			Paying into Social Security since 1997
		</p>
		<span class="h-px w-8 bg-gradient-to-l from-transparent to-foundation-gold/70" aria-hidden="true"></span>
	</div>
	<ol class="experience-timeline mt-10 list-none space-y-0" role="list">
		{
			entries.map((e, i) => (
				<li class="experience-item relative pl-8 md:pl-10">
					<span class="experience-dot" aria-hidden="true" />
					<p class="font-display text-lg font-semibold leading-tight text-site-gold md:text-xl">{e.role}</p>
					<p class="mt-1 font-serif text-[1.02rem] leading-snug text-site-ink md:text-[1.06rem]">
						{
							e.href ? (
								<a
									href={e.href}
									class="text-site-gold underline-offset-4 transition-colors hover:underline"
								>
									{e.organization}
								</a>
							) : (
								e.organization
							)
						}
					</p>
					<p class="mt-2 font-serif text-[0.95rem] leading-relaxed text-site-muted md:text-[0.98rem]">{e.summary}</p>
					{i < entries.length - 1 ? <div class="experience-connector" aria-hidden="true" /> : null}
				</li>
			))
		}
	</ol>
</section>

<style>
	.experience-timeline {
		position: relative;
	}

	.experience-item {
		padding-bottom: 2.25rem;
	}

	.experience-item:last-child {
		padding-bottom: 0;
	}

	.experience-dot {
		position: absolute;
		left: 0.375rem;
		top: 0.35rem;
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 9999px;
		background: linear-gradient(145deg, rgba(201, 169, 98, 0.95), rgba(201, 169, 98, 0.45));
		box-shadow:
			0 0 0 2px rgba(12, 11, 9, 0.95),
			0 0 12px rgba(201, 169, 98, 0.35);
	}

	.experience-connector {
		position: absolute;
		left: 0.56rem;
		top: 1.15rem;
		bottom: 0;
		width: 1px;
		background: linear-gradient(
			180deg,
			rgba(201, 169, 98, 0.45) 0%,
			rgba(201, 169, 98, 0.12) 85%,
			transparent 100%
		);
	}
</style>
