---
import type { GatewayLink } from '../data/gateway-links';

interface Props {
	link: GatewayLink;
	compact?: boolean;
	/** Hide the always-visible caption; show label in a hover/focus tooltip instead. */
	labelOnHover?: boolean;
	/** Stagger logo pulse animation (seconds). */
	pulseDelay?: number;
}

const { link, compact = false, labelOnHover = false, pulseDelay } = Astro.props;

const externalProps = link.external
	? { target: '_blank' as const, rel: 'noopener noreferrer' as const }
	: {};
---

<a
	href={link.href}
	class:list={[
		'gateway-link-tile group relative inline-flex flex-col items-center gap-2.5 transition-transform duration-300 hover:-translate-y-1 hover:scale-105 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-site-horizon',
		compact && 'gateway-link-tile--compact',
		labelOnHover && 'gateway-link-tile--hover-label'
	]}
	style={pulseDelay !== undefined ? `--pulse-delay: ${pulseDelay}s` : undefined}
	aria-label={link.label}
	{...externalProps}
>
	<span class="gateway-link-tile__disc">
		<span
			class:list={[
				'gateway-link-tile__mark',
				!compact && link.id !== 'adloris' && link.id !== 'thermal-underground' && 'gateway-link-tile__mark--pulse'
			]}
		>
			{
				link.kind === 'image' && link.imageSrc && (
					<img
						src={link.imageSrc}
						alt=""
						width="512"
						height="512"
						class:list={[
							'gateway-link-tile__img',
							link.id === 'allasys' && 'gateway-link-tile__img--allasys',
							link.id === 'adloris' && 'gateway-link-tile__img--adloris',
							link.id === 'thermal-underground' && 'gateway-link-tile__img--thermal'
						]}
						loading="lazy"
						decoding="async"
						aria-hidden="true"
					/>
				)
			}
			{
				link.kind === 'wordmark' && (
					<span
						class:list={[
							'gateway-link-tile__wordmark',
							link.wordmarkFont === 'fraunces'
								? 'gateway-link-tile__wordmark--fraunces'
								: 'gateway-link-tile__wordmark--monoton font-brand'
						]}
					>
						{link.wordmark}
					</span>
				)
			}
			{
				link.kind === 'svg' && link.svg === 'linkedin' && (
					<svg class="gateway-link-tile__svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path
							d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
						></path>
					</svg>
				)
			}
			{
				link.kind === 'svg' && link.svg === 'instagram' && (
					<svg class="gateway-link-tile__svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path
							d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
						></path>
					</svg>
				)
			}
			{
				link.kind === 'svg' && link.svg === 'x' && (
					<svg class="gateway-link-tile__svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path
							d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
						></path>
					</svg>
				)
			}
		</span>
	</span>
	{
		labelOnHover ? (
			<span class="gateway-link-tile__tooltip font-mono text-[10px] uppercase tracking-[0.18em]">
				{link.label}
			</span>
		) : (
			!compact && (
				<span class="gateway-link-tile__label font-mono text-[10px] uppercase tracking-[0.22em] text-site-muted transition-colors group-hover:text-site-gold">
					{link.label}
				</span>
			)
		)
	}
</a>

<style>
	.gateway-link-tile__disc {
		display: flex;
		align-items: center;
		justify-content: center;
		background: none;
		border: none;
		box-shadow: none;
	}

	.gateway-link-tile__mark {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 6.5rem;
		height: 5.85rem;
		flex-shrink: 0;
		transition: transform 0.3s ease;
	}

	.gateway-link-tile__mark--pulse {
		animation: gateway-logo-glow 2.8s ease-in-out infinite;
		animation-delay: var(--pulse-delay, 0s);
	}

	.gateway-link-tile:hover .gateway-link-tile__mark--pulse,
	.gateway-link-tile:focus-visible .gateway-link-tile__mark--pulse {
		animation-duration: 2.2s;
	}

	.gateway-link-tile:hover .gateway-link-tile__img--thermal,
	.gateway-link-tile:focus-visible .gateway-link-tile__img--thermal {
		animation-duration: 2.2s;
	}

	.gateway-link-tile:not(.gateway-link-tile--compact) .gateway-link-tile__img--thermal {
		animation: gateway-logo-glow-thermal 2.8s ease-in-out infinite;
		animation-delay: var(--pulse-delay, 0s);
	}

	.gateway-link-tile:not(.gateway-link-tile--compact) .gateway-link-tile__wordmark--monoton,
	.gateway-link-tile:not(.gateway-link-tile--compact) .gateway-link-tile__wordmark--fraunces {
		animation: gateway-wordmark-glow 2.8s ease-in-out infinite;
		animation-delay: var(--pulse-delay, 0s);
	}

	@keyframes gateway-logo-glow {
		0%,
		100% {
			filter: drop-shadow(0 0 5px rgba(201, 148, 58, 0.22)) drop-shadow(0 2px 8px rgba(0, 0, 0, 0.35));
		}
		50% {
			filter: drop-shadow(0 0 16px rgba(201, 148, 58, 0.52)) drop-shadow(0 0 28px rgba(255, 220, 160, 0.18))
				drop-shadow(0 2px 12px rgba(0, 0, 0, 0.4));
		}
	}

	@keyframes gateway-logo-glow-thermal {
		0%,
		100% {
			filter: drop-shadow(0 0 6px rgba(180, 35, 24, 0.35)) drop-shadow(0 2px 8px rgba(0, 0, 0, 0.3));
		}
		50% {
			filter: drop-shadow(0 0 18px rgba(220, 55, 40, 0.6)) drop-shadow(0 0 32px rgba(255, 100, 70, 0.28))
				drop-shadow(0 2px 12px rgba(0, 0, 0, 0.35));
		}
	}

	/* Glow sits behind the PNG so it reads through the transparent sky */
	.gateway-link-tile:not(.gateway-link-tile--compact) .gateway-link-tile__mark:has(.gateway-link-tile__img--thermal) {
		position: relative;
	}

	.gateway-link-tile:not(.gateway-link-tile--compact) .gateway-link-tile__mark:has(.gateway-link-tile__img--thermal)::before {
		content: '';
		position: absolute;
		inset: 12% 18% 28%;
		z-index: 0;
		border-radius: 50%;
		background: radial-gradient(
			circle at 50% 70%,
			rgba(255, 120, 40, 0.55) 0%,
			rgba(220, 45, 30, 0.28) 42%,
			transparent 72%
		);
		pointer-events: none;
		animation: gateway-thermal-sky-glow 2.8s ease-in-out infinite;
		animation-delay: var(--pulse-delay, 0s);
	}

	.gateway-link-tile:not(.gateway-link-tile--compact) .gateway-link-tile__mark:has(.gateway-link-tile__img--thermal) .gateway-link-tile__img--thermal {
		position: relative;
		z-index: 1;
	}

	@keyframes gateway-thermal-sky-glow {
		0%,
		100% {
			opacity: 0.72;
			transform: scale(0.96);
		}
		50% {
			opacity: 1;
			transform: scale(1.04);
		}
	}

	@keyframes gateway-wordmark-glow {
		0%,
		100% {
			text-shadow: 0 0 6px rgba(201, 148, 58, 0.15);
		}
		50% {
			text-shadow:
				0 0 12px rgba(201, 148, 58, 0.45),
				0 0 24px rgba(255, 220, 160, 0.18);
		}
	}

	.gateway-link-tile:hover .gateway-link-tile__mark,
	.gateway-link-tile:focus-visible .gateway-link-tile__mark {
		transform: scale(1.03);
	}

	.gateway-link-tile--compact .gateway-link-tile__disc {
		width: auto;
		height: auto;
	}

	.gateway-link-tile--compact .gateway-link-tile__mark {
		width: 1.35rem;
		height: 1.25rem;
	}

	.gateway-link-tile__img {
		display: block;
		width: 6.5rem;
		height: 5.85rem;
		object-fit: contain;
		object-position: center;
		transition: filter 0.3s ease;
	}

	/* Allasys mark fills its canvas edge-to-edge; scale to match circular logos */
	.gateway-link-tile__img--allasys {
		width: 5rem;
		height: 4.5rem;
	}

	/* Adloris hero logo — light mark on dark ground */
	.gateway-link-tile__img--adloris {
		width: 7.25rem;
		height: 6.5rem;
	}

	.gateway-link-tile:not(.gateway-link-tile--compact) .gateway-link-tile__img--adloris {
		animation: gateway-logo-glow-adloris 2.8s ease-in-out infinite;
		animation-delay: var(--pulse-delay, 0s);
	}

	@keyframes gateway-logo-glow-adloris {
		0%,
		100% {
			filter: drop-shadow(0 0 6px rgba(201, 148, 58, 0.25)) drop-shadow(0 2px 10px rgba(0, 0, 0, 0.35));
		}
		50% {
			filter: drop-shadow(0 0 16px rgba(201, 148, 58, 0.55)) drop-shadow(0 0 28px rgba(212, 160, 60, 0.28))
				drop-shadow(0 2px 12px rgba(0, 0, 0, 0.4));
		}
	}

	.gateway-link-tile--compact .gateway-link-tile__img {
		width: 1.35rem;
		height: 1.25rem;
	}

	.gateway-link-tile--compact .gateway-link-tile__img--allasys {
		width: 1.05rem;
		height: 0.95rem;
	}

	.gateway-link-tile--compact .gateway-link-tile__img--adloris {
		width: 1.45rem;
		height: 1.3rem;
	}

	.gateway-link-tile--compact .gateway-link-tile__img--thermal {
		width: 1.35rem;
		height: 1.35rem;
	}

	.gateway-link-tile__svg {
		display: block;
		width: 6.5rem;
		height: auto;
		max-height: 5.85rem;
		max-width: 6.5rem;
		color: var(--color-site-muted);
		transition: color 0.3s ease;
	}

	.gateway-link-tile--compact .gateway-link-tile__svg {
		width: 1.35rem;
		max-height: 1.25rem;
		max-width: 1.35rem;
	}

	.gateway-link-tile:hover .gateway-link-tile__svg,
	.gateway-link-tile:focus-visible .gateway-link-tile__svg {
		color: var(--color-site-gold);
	}

	.gateway-link-tile__wordmark {
		display: block;
		width: 100%;
		text-align: center;
		color: var(--color-site-gold);
		line-height: 1.05;
	}

	.gateway-link-tile__wordmark--monoton {
		font-family: var(--font-brand);
		font-size: clamp(1.125rem, 2.6vw, 1.5rem);
		font-weight: 400;
		line-height: 1;
		letter-spacing: normal;
		color: var(--color-foundation-gold);
		white-space: nowrap;
	}

	.gateway-link-tile__wordmark--fraunces {
		font-family: 'Fraunces', Georgia, serif;
		font-optical-sizing: auto;
		font-size: 1.55rem;
		font-weight: 300;
		font-style: italic;
		letter-spacing: 0.01em;
	}

	.gateway-link-tile--compact .gateway-link-tile__wordmark--monoton {
		font-size: 0.58rem;
	}

	.gateway-link-tile--compact .gateway-link-tile__wordmark--fraunces {
		font-size: 0.62rem;
	}

	.gateway-link-tile__label {
		max-width: 8rem;
		text-align: center;
		line-height: 1.35;
	}

	.gateway-link-tile__tooltip {
		position: absolute;
		bottom: calc(100% + 0.55rem);
		left: 50%;
		z-index: 20;
		max-width: 11rem;
		padding: 0.4rem 0.7rem;
		border-radius: 0.35rem;
		border: 1px solid var(--color-site-border);
		background: rgba(18, 32, 56, 0.96);
		color: var(--color-site-ink);
		text-align: center;
		line-height: 1.35;
		white-space: normal;
		pointer-events: none;
		opacity: 0;
		visibility: hidden;
		transform: translateX(-50%) translateY(6px);
		box-shadow:
			0 4px 20px rgba(0, 0, 0, 0.45),
			0 0 0 1px rgba(212, 184, 122, 0.08) inset;
		transition:
			opacity 0.22s ease,
			transform 0.22s ease,
			visibility 0.22s ease;
	}

	.gateway-link-tile--hover-label:hover .gateway-link-tile__tooltip,
	.gateway-link-tile--hover-label:focus-visible .gateway-link-tile__tooltip {
		opacity: 1;
		visibility: visible;
		transform: translateX(-50%) translateY(0);
	}

	.gateway-link-tile--hover-label:hover,
	.gateway-link-tile--hover-label:focus-visible {
		z-index: 30;
	}

	@media (prefers-reduced-motion: reduce) {
		.gateway-link-tile__mark--pulse,
		.gateway-link-tile:not(.gateway-link-tile--compact) .gateway-link-tile__img--adloris,
		.gateway-link-tile:not(.gateway-link-tile--compact) .gateway-link-tile__img--thermal,
		.gateway-link-tile:not(.gateway-link-tile--compact) .gateway-link-tile__wordmark--monoton,
		.gateway-link-tile:not(.gateway-link-tile--compact) .gateway-link-tile__wordmark--fraunces,
		.gateway-link-tile:not(.gateway-link-tile--compact) .gateway-link-tile__mark:has(.gateway-link-tile__img--thermal)::before {
			animation: none !important;
		}

		.gateway-link-tile:not(.gateway-link-tile--compact) .gateway-link-tile__mark:has(.gateway-link-tile__img--thermal)::before {
			opacity: 0.85;
			transform: none;
		}

		.gateway-link-tile__img--adloris {
			filter: drop-shadow(0 0 4px rgba(201, 148, 58, 0.2));
		}
	}
</style>
