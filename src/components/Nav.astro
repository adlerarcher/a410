---
interface Props {
	overlay?: boolean;
}

const { overlay = false } = Astro.props;
---

<header
	class:list={[
		'z-50',
		overlay ? 'absolute inset-x-0 top-0 border-none bg-transparent' : 'relative border-b border-site-border bg-site-cream/90'
	]}
>
	<div class="mx-auto flex max-w-5xl items-center justify-between gap-6 px-6 py-5">
		<a
			href="/"
			class="group inline-flex shrink-0 items-center gap-3 transition-opacity hover:opacity-95"
			aria-label="AI410 home"
		>
			<img
				src="/images/ai410-mark.svg"
				alt=""
				width="36"
				height="36"
				class="h-8 w-8 sm:h-9 sm:w-9"
				decoding="async"
			/>
			<span class="font-display text-xl font-semibold tracking-tight text-site-gold sm:text-2xl">AI410</span>
		</a>
		<p class="hidden font-mono text-[10px] uppercase tracking-[0.2em] text-site-muted sm:block">
			AI explained like you are 10
		</p>
	</div>
</header>
