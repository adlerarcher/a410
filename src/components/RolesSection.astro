---
import { CURRENT_ROLES } from '../data/roles';
---

<section id="roles" class="scroll-mt-24 border-t border-site-border/70 px-6 py-14 md:py-20" aria-labelledby="roles-heading">
	<div class="mx-auto max-w-3xl">
		<h2 id="roles-heading" class="font-display text-2xl font-semibold text-site-ink md:text-3xl">
			Roles &amp; affiliations
		</h2>
		<p class="mt-3 font-serif text-site-muted">Present-tense map of current roles. Not a career history.</p>
		<ul class="mt-8 space-y-6">
			{
				CURRENT_ROLES.map((role) => (
					<li class="border-l-2 border-site-gold/35 pl-4">
						<p class="font-display text-lg font-medium text-site-ink">{role.role}</p>
						<p class="mt-0.5 font-serif text-site-gold">
							{
								role.href ? (
									<a
										href={role.href}
										class="underline-offset-4 hover:underline"
										{...(role.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
									>
										{role.organization}
									</a>
								) : (
									role.organization
								)
							}
						</p>
						<p class="mt-1 font-serif text-sm leading-relaxed text-site-muted">{role.summary}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>
