---
import { GATEWAY_LINKS } from '../data/gateway-links';
import GatewayLinkTile from './GatewayLinkTile.astro';
import GatewayCompass from './GatewayCompass.astro';

const helloChars = [...'Hello,'];
const worldChars = [...'world'];
---

<section
	id="start"
	class="gateway-hero relative flex min-h-screen flex-1 scroll-mt-24 flex-col items-center justify-center overflow-hidden px-6 pb-16 pt-28 md:pb-20 md:pt-32"
>
	<div class="gateway-hero__inner relative z-[1] mx-auto w-full max-w-5xl">
		<header class="gateway-hero__masthead text-center">
			<div class="gateway-hero__title-flare" aria-hidden="true"></div>
			<h1
				class="gateway-hero__title font-display text-[clamp(2.75rem,9vw,5.75rem)] font-light leading-[0.95] tracking-tight text-site-ink"
				aria-label="Adler Archer — Hello, world"
			>
				<span class="gateway-hero__word" aria-hidden="true">
					{
						helloChars.map((char, index) => (
							<span class="gateway-hero__char" style={`--char-i: ${index}`}>
								{char}
							</span>
						))
					}
				</span>{' '}
				<span class="gateway-hero__word gateway-hero__word--world" aria-hidden="true">
					{
						worldChars.map((char, index) => (
							<span class="gateway-hero__char gateway-hero__char--world" style={`--char-i: ${index}`}>
								{char}
							</span>
						))
					}
				</span>
			</h1>
			<p class="gateway-hero__person font-major-mono mt-3 text-[11px] uppercase tracking-[0.28em] text-site-muted md:mt-4">
				Adler Archer
			</p>
		</header>

		<div class="gateway-hero__stage mt-8 md:mt-10" aria-label="Ecosystem links">
			<div class="gateway-hero__compass">
				<GatewayCompass size="hero" />
			</div>
			<ul class="gateway-hero__links m-0 list-none p-0">
				{
					GATEWAY_LINKS.map((link, index) => (
						<li
							class="gateway-hero__link-item"
							style={`--link-i: ${index}`}
						>
							<GatewayLinkTile link={link} labelOnHover pulseDelay={index * 0.35} />
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>

<style>
	.gateway-hero {
		background: transparent;
	}

	.gateway-hero__masthead {
		position: relative;
		isolation: isolate;
		animation:
			gateway-masthead-in 1.1s cubic-bezier(0.22, 1, 0.36, 1) both,
			gateway-masthead-float 5s ease-in-out 1.4s infinite;
	}

	.gateway-hero__title-flare {
		position: absolute;
		top: 50%;
		left: 50%;
		z-index: -2;
		width: min(90vw, 36rem);
		height: min(40vw, 14rem);
		transform: translate(-50%, -50%);
		border-radius: 9999px;
		background: radial-gradient(
			ellipse at center,
			rgba(255, 220, 150, 0.75) 0%,
			rgba(201, 148, 58, 0.45) 28%,
			rgba(61, 117, 136, 0.18) 52%,
			transparent 72%
		);
		filter: blur(8px);
		pointer-events: none;
		animation: gateway-title-flare-burst 1.35s cubic-bezier(0.22, 1, 0.36, 1) 0.05s both;
	}

	.gateway-hero__title {
		position: relative;
		margin: 0;
		animation:
			gateway-title-glow 2.1s ease-in-out 1.1s infinite,
			gateway-title-breathe 3.2s ease-in-out 1.1s infinite;
		will-change: text-shadow, transform, filter;
	}

	.gateway-hero__word {
		display: inline-block;
	}

	.gateway-hero__char {
		display: inline-block;
		transform-origin: 50% 100%;
		animation:
			gateway-char-slam 0.82s cubic-bezier(0.22, 1.25, 0.36, 1) calc(0.12s + var(--char-i) * 0.055s) both,
			gateway-char-float 3.6s ease-in-out calc(1.2s + var(--char-i) * 0.09s) infinite;
	}

	.gateway-hero__char--world {
		animation:
			gateway-char-slam 0.88s cubic-bezier(0.22, 1.35, 0.36, 1) calc(0.62s + var(--char-i) * 0.075s) both,
			gateway-char-world-glow 2.4s ease-in-out calc(1.35s + var(--char-i) * 0.12s) infinite,
			gateway-char-float 3.2s ease-in-out calc(1.4s + var(--char-i) * 0.11s) infinite;
	}

	.gateway-hero__stage {
		--link-logo-width: 6.75rem;
		--link-logo-height: 6.15rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		animation: gateway-stage-in 1.2s cubic-bezier(0.22, 1, 0.36, 1) 0.35s both;
	}

	.gateway-hero__compass {
		display: flex;
		justify-content: center;
		padding-top: 0.5rem;
		padding-bottom: 2.5rem;
		animation: gateway-compass-float 6s ease-in-out infinite;
	}

	.gateway-hero__compass :global(.gateway-compass) {
		--compass-size: 13rem;
	}

	.gateway-hero__links {
		display: flex;
		width: 100%;
		max-width: 56rem;
		flex-wrap: wrap;
		align-items: flex-start;
		justify-content: center;
		gap: 1.5rem 2rem;
	}

	.gateway-hero__link-item {
		flex: 0 1 auto;
		animation: gateway-link-in 0.85s cubic-bezier(0.22, 1, 0.36, 1) calc(0.5s + var(--link-i) * 0.08s) both;
	}

	.gateway-hero__stage :global(.gateway-link-tile__mark) {
		width: var(--link-logo-width);
		height: var(--link-logo-height);
	}

	.gateway-hero__stage :global(.gateway-link-tile__img),
	.gateway-hero__stage :global(.gateway-link-tile__svg) {
		width: var(--link-logo-width);
		height: var(--link-logo-height);
		max-width: var(--link-logo-width);
		max-height: var(--link-logo-height);
	}

	.gateway-hero__stage :global(.gateway-link-tile__img--allasys) {
		width: 5.75rem;
		height: 5.15rem;
	}

	.gateway-hero__stage :global(.gateway-link-tile__img--adloris) {
		width: 8rem;
		height: 7.2rem;
	}

	@media (min-width: 768px) {
		.gateway-hero__stage {
			--link-logo-width: 8.5rem;
			--link-logo-height: 7.65rem;
		}

		.gateway-hero__compass {
			padding-top: 0.75rem;
			padding-bottom: 3.5rem;
		}

		.gateway-hero__compass :global(.gateway-compass) {
			--compass-size: 15rem;
		}

		.gateway-hero__links {
			flex-wrap: nowrap;
			gap: 1.75rem 2.25rem;
		}

		.gateway-hero__stage :global(.gateway-link-tile__img--allasys) {
			width: 7rem;
			height: 6.3rem;
		}

		.gateway-hero__stage :global(.gateway-link-tile__img--adloris) {
			width: 9.5rem;
			height: 8.55rem;
		}
	}

	@keyframes gateway-masthead-float {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-0.35rem);
		}
	}

	@keyframes gateway-compass-float {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-0.5rem);
		}
	}

	@keyframes gateway-masthead-in {
		from {
			opacity: 0;
			transform: translateY(1.5rem);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes gateway-title-flare-burst {
		0% {
			opacity: 0;
			transform: translate(-50%, -50%) scale(0.2);
			filter: blur(24px);
		}
		35% {
			opacity: 1;
			transform: translate(-50%, -50%) scale(1.35);
			filter: blur(4px);
		}
		100% {
			opacity: 0.55;
			transform: translate(-50%, -50%) scale(1);
			filter: blur(10px);
		}
	}

	@keyframes gateway-title-glow {
		0%,
		100% {
			text-shadow:
				0 0 12px rgba(255, 230, 180, 0.35),
				0 0 28px rgba(201, 148, 58, 0.28),
				0 0 52px rgba(201, 148, 58, 0.14),
				0 2px 24px rgba(42, 36, 28, 0.08);
			filter: brightness(1);
		}
		50% {
			text-shadow:
				0 0 20px rgba(255, 245, 220, 0.75),
				0 0 40px rgba(255, 200, 100, 0.55),
				0 0 72px rgba(201, 148, 58, 0.42),
				0 0 96px rgba(61, 117, 136, 0.2),
				0 4px 32px rgba(201, 148, 58, 0.25);
			filter: brightness(1.08);
		}
	}

	@keyframes gateway-title-breathe {
		0%,
		100% {
			transform: scale(1) rotate(-0.55deg);
		}
		50% {
			transform: scale(1.045) rotate(0.55deg);
		}
	}

	@keyframes gateway-char-slam {
		0% {
			opacity: 0;
			transform: translateY(-2.75rem) scale(2.1) rotate(-12deg);
			filter: blur(14px) brightness(2.8);
			text-shadow: 0 0 40px rgba(255, 240, 200, 0.95);
		}
		55% {
			opacity: 1;
			transform: translateY(0.35rem) scale(0.92) rotate(2deg);
			filter: blur(0) brightness(1.35);
		}
		75% {
			transform: translateY(-0.2rem) scale(1.06) rotate(-1deg);
			filter: brightness(1.15);
		}
		100% {
			opacity: 1;
			transform: translateY(0) scale(1) rotate(0deg);
			filter: blur(0) brightness(1);
			text-shadow: none;
		}
	}

	@keyframes gateway-char-float {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-0.22rem);
		}
	}

	@keyframes gateway-char-world-glow {
		0%,
		100% {
			color: var(--color-site-ink);
			text-shadow: 0 0 8px rgba(201, 148, 58, 0.15);
		}
		50% {
			color: #d4b87a;
			text-shadow:
				0 0 16px rgba(255, 210, 120, 0.65),
				0 0 32px rgba(201, 148, 58, 0.45);
		}
	}

	@keyframes gateway-stage-in {
		from {
			opacity: 0;
			transform: translateY(1.25rem);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes gateway-link-in {
		from {
			opacity: 0;
			transform: translateY(1rem) scale(0.9);
		}
		to {
			opacity: 1;
			transform: translateY(0) scale(1);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.gateway-hero__masthead,
		.gateway-hero__title,
		.gateway-hero__title-flare,
		.gateway-hero__word,
		.gateway-hero__char,
		.gateway-hero__stage,
		.gateway-hero__compass,
		.gateway-hero__link-item {
			animation: none !important;
		}
	}
</style>
