---
import FounderStage from './FounderStage.astro';
---

<section
	class="hero-section relative min-h-[min(82vh,880px)] overflow-hidden px-6 pb-20 pt-28 md:min-h-[min(90vh,1020px)] md:pb-32 md:pt-36"
>
	<!-- Background: scenic mountains -->
	<div class="hero-bg-wrap pointer-events-none absolute inset-0">
		<img
			src="/images/hero-mountains-alpine.jpg"
			alt=""
			width="1920"
			height="1280"
			class="hero-bg-img h-full w-full object-cover object-[center_52%] opacity-[0.42] md:object-[center_48%]"
			loading="eager"
			fetchpriority="high"
			decoding="async"
		/>
	</div>
	<div
		class="pointer-events-none absolute inset-0 bg-gradient-to-t from-site-cream via-site-cream/75 to-site-cream/30"
		aria-hidden="true"
	>
	</div>
	<div
		class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_100%_70%_at_50%_85%,rgba(201,169,98,0.08),transparent_55%)]"
		aria-hidden="true"
	>
	</div>
	<div class="hero-orb hero-orb--1" aria-hidden="true"></div>
	<div class="hero-orb hero-orb--2" aria-hidden="true"></div>
	<div class="hero-orb hero-orb--3" aria-hidden="true"></div>
	<div class="hero-orb hero-orb--4" aria-hidden="true"></div>
	<div
		class="pointer-events-none absolute inset-0 bg-gradient-to-b from-site-cream via-transparent to-site-cream hero-gradient-pulse"
	>
	</div>
	<div
		class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_50%_0%,rgba(61,95,77,0.12),transparent_50%)]"
	>
	</div>
	<div
		class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_80%_60%_at_80%_100%,rgba(107,45,58,0.08),transparent_55%)]"
		aria-hidden="true"
	>
	</div>
	<div class="hero-shimmer" aria-hidden="true"></div>
	<div class="hero-float-dust" aria-hidden="true">
		<span></span>
		<span></span>
		<span></span>
		<span></span>
		<span></span>
		<span></span>
		<span></span>
		<span></span>
	</div>
	<div class="relative z-[1] mx-auto flex w-full max-w-6xl flex-col items-center gap-12 md:gap-16">
		<div class="hero-headline max-w-3xl shrink-0 px-2 text-center">
			<h1
				class="flex flex-col items-center gap-2 sm:flex-row sm:flex-wrap sm:justify-center sm:gap-x-3 sm:gap-y-1 sm:items-baseline"
				aria-label="Adler Archer, A personal site."
			>
				<span class="hero-title-serif text-[clamp(1.85rem,5vw,3.35rem)] tracking-[0.02em]">Adler Archer</span>
				<span class="flex items-baseline justify-center gap-2.5 sm:gap-3">
					<span class="hero-slash select-none font-serif text-[clamp(1.15rem,3.2vw,1.5rem)] font-light leading-none text-site-gold/50" aria-hidden="true">/</span>
					<span
						id="hero-typewriter-tagline"
						class="hero-typewriter-target text-left font-mono text-[1.05rem] font-normal leading-[1.75] tracking-[0.04em] text-site-muted md:text-[1.2rem] md:leading-[1.85]"
						aria-live="off"
					>A personal site.</span>
				</span>
			</h1>
		</div>
		<script is:inline>
			(function () {
				function runTypewriter() {
					var el = document.getElementById('hero-typewriter-tagline');
					if (!el) return;
					var full = 'A personal site.';
					if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
						el.textContent = full;
						el.classList.add('hero-typewriter--done');
						return;
					}
					el.classList.remove('hero-typewriter--done');
					el.textContent = '';
					var charMs = 68;
					var deleteMs = 42;
					var holdTyped = 2400;
					var holdEmpty = 900;
					var startAfter = 1150;

					function typeForward(i) {
						if (i <= full.length) {
							el.textContent = full.slice(0, i);
							if (i === full.length) {
								window.setTimeout(function () {
									deleteBack(full.length);
								}, holdTyped);
								return;
							} else {
								window.setTimeout(function () {
									typeForward(i + 1);
								}, charMs);
							}
						}
					}

					/** i = current visible length; peel one character per step */
					function deleteBack(i) {
						if (i === 0) {
							el.textContent = '';
							window.setTimeout(function () {
								typeForward(0);
							}, holdEmpty);
							return;
						}
						el.textContent = full.slice(0, i - 1);
						window.setTimeout(function () {
							deleteBack(i - 1);
						}, deleteMs);
					}

					window.setTimeout(function () {
						typeForward(0);
					}, startAfter);
				}
				if (document.readyState === 'loading') {
					document.addEventListener('DOMContentLoaded', runTypewriter);
				} else {
					runTypewriter();
				}
			})();
		</script>
		<div
			class="hero-portrait-wrap isolate flex w-full max-w-[min(416px,74vw)] justify-center [&_.founder-photo-card>div:nth-child(2)]:hidden"
		>
			<FounderStage variant="hero" />
		</div>
		<blockquote
			class="hero-morrison-quote relative mx-auto mt-12 w-full max-w-[34rem] px-5 py-10 text-center md:mt-16 md:max-w-[36rem] md:px-8 md:py-12 lg:mt-20"
		>
			<p class="hero-quote-text font-serif text-base italic leading-[1.65] text-site-ink/92 md:text-[1.125rem] md:leading-relaxed">
				&ldquo;Freeing yourself was one thing, claiming ownership of that freed self was another.&rdquo;
			</p>
			<footer class="hero-quote-attrib mt-6 font-display text-sm font-normal tracking-[0.12em] text-site-gold md:mt-7">
				&mdash; Toni Morrison
			</footer>
		</blockquote>
	</div>
</section>
