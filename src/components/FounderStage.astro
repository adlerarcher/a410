---
interface Props {
	variant?: 'about' | 'hero';
	/** Tight bottom spacing when nested inside a founder band (e.g. About page). */
	flush?: boolean;
	/** Light card styling for the warm site palette. */
	tone?: 'light' | 'dark';
	/** Show ", JD" under the portrait name (off on About portrait). */
	showJd?: boolean;
}
const { variant = 'about', flush = false, tone = 'dark', showJd = true } = Astro.props;
const nameLine = showJd ? 'Adler Archer, JD' : 'Adler Archer';
const cardFooterLabel = variant === 'about' ? 'About Me' : 'Est. 2013';
const imgAlt = nameLine;
const toneClass = tone === 'light' ? 'founder-stage--light' : '';
const heroClass =
	'reveal-slide-left founder-photo-stage mx-auto mb-0 max-w-[min(288px,70vw)] md:max-w-[min(336px,68vw)] lg:max-w-[min(384px,66vw)]';
const aboutClass = flush
	? 'reveal-slide-left founder-photo-stage mx-auto mb-0 max-w-[320px] md:max-w-[360px]'
	: 'reveal-slide-left founder-photo-stage mx-auto mb-14 max-w-[320px] md:mb-16 md:max-w-[360px]';
const rootClass = variant === 'hero' ? heroClass : aboutClass;
---

<div class:list={[rootClass, toneClass]} data-founder-reveal>
<div class="founder-portrait-wrap card-shimmer group relative z-[1] block rounded-2xl outline-none ring-inset focus-visible:ring-2 focus-visible:ring-foundation-gold/60">
<div class="founder-photo-fx pointer-events-none absolute overflow-visible" aria-hidden="true">
