</div>
<div class="pointer-events-none absolute -inset-[2px] rounded-[1.2rem] bg-gradient-to-br from-foundation-gold/50 via-foundation-gold/10 to-warm-copper/40 opacity-90 blur-[1px] transition-opacity duration-500 group-hover:opacity-100" aria-hidden="true"></div> <div class="founder-photo-card relative z-[1] overflow-hidden rounded-2xl border border-foundation-gold/40 bg-warm-midnight/90 shadow-[0_28px_64px_-28px_rgba(0,0,0,0.55)] backdrop-blur-[2px] transition-[box-shadow,transform] duration-300 ease-out group-hover:shadow-[0_0_25px_rgba(212,160,60,0.25),0_28px_64px_-28px_rgba(0,0,0,0.5)]"> <div class="relative aspect-square overflow-hidden"> <img src="/images/adler-archer.png" alt={imgAlt} width="1024" height="673" loading="lazy" decoding="async" class="h-full w-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-[1.02]"> </div> <div class="border-t border-foundation-gold/30 px-5 pb-5 pt-6 text-center md:px-6 md:pb-6"> <h2 class="font-caveat text-3xl font-bold leading-tight text-cream md:text-4xl"> {nameLine} </h2> <div class="mx-auto mt-6 flex items-center justify-center gap-2.5" aria-hidden="true"> <span class="h-px w-8 bg-gradient-to-r from-transparent to-foundation-gold/70"></span> <span class="font-mono text-[10px] uppercase tracking-[0.35em] text-warm-gray/90">{cardFooterLabel}</span> <span class="h-px w-8 bg-gradient-to-l from-transparent to-foundation-gold/70"></span> </div> </div> <div class="pointer-events-none absolute -bottom-1 -right-1 h-16 w-16 rounded-br-2xl border-b-2 border-r-2 border-foundation-gold/50" aria-hidden="true"></div> </div> </div> </div>