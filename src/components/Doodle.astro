---
interface Props {
	kind: 'lessons' | 'words' | 'memes' | 'who' | 'walker' | 'sat' | 'rocket' | 'planet' | 'ufo';
}
const { kind } = Astro.props;
---

{
	kind === 'lessons' && (
		<svg class="cartoon" viewBox="0 0 88 88" aria-hidden="true">
			<rect x="28" y="14" width="32" height="26" rx="8" fill="#F9FBFC" stroke="#16232B" stroke-width="2" />
			<circle cx="38" cy="26" r="3" fill="#2A4FD6" />
			<circle cx="50" cy="26" r="3" fill="#2A4FD6" />
			<rect x="40" y="8" width="8" height="8" rx="1" fill="#FFE24A" stroke="#16232B" stroke-width="1.5" />
			<circle cx="44" cy="8" r="2.5" fill="#D2372C" />
			<rect x="24" y="40" width="40" height="28" rx="6" fill="#FFE24A" stroke="#16232B" stroke-width="2" />
			<rect x="32" y="46" width="24" height="14" rx="2" fill="#F9FBFC" stroke="#16232B" stroke-width="1.5" />
			<path d="M32 50h16M32 54h12" stroke="#2A4FD6" stroke-width="1.5" />
			<rect x="16" y="44" width="8" height="16" rx="3" fill="#F9FBFC" stroke="#16232B" stroke-width="2" />
			<rect x="64" y="44" width="8" height="16" rx="3" fill="#F9FBFC" stroke="#16232B" stroke-width="2" />
			<rect x="30" y="68" width="8" height="12" rx="3" fill="#16232B" />
			<rect x="50" y="68" width="8" height="12" rx="3" fill="#16232B" />
		</svg>
	)
}
{
	kind === 'words' && (
		<svg class="cartoon" viewBox="0 0 88 88" aria-hidden="true">
			<rect x="26" y="16" width="36" height="28" rx="10" fill="#F9FBFC" stroke="#16232B" stroke-width="2" />
			<circle cx="37" cy="30" r="3.5" fill="#16232B" />
			<circle cx="51" cy="30" r="3.5" fill="#16232B" />
			<path d="M40 38c2 3 6 3 8 0" stroke="#D2372C" stroke-width="1.8" fill="none" />
			<rect x="42" y="10" width="4" height="8" fill="#2A4FD6" />
			<circle cx="44" cy="10" r="3" fill="#FFE24A" stroke="#16232B" stroke-width="1.5" />
			<rect x="22" y="44" width="44" height="22" rx="5" fill="#2A4FD6" stroke="#16232B" stroke-width="2" />
			<text x="44" y="60" text-anchor="middle" font-size="11" font-family="ui-monospace, monospace" fill="#F9FBFC">abc</text>
			<rect x="14" y="48" width="8" height="14" rx="3" fill="#F9FBFC" stroke="#16232B" stroke-width="2" />
			<rect x="66" y="48" width="8" height="14" rx="3" fill="#F9FBFC" stroke="#16232B" stroke-width="2" />
			<rect x="30" y="66" width="8" height="12" rx="3" fill="#16232B" />
			<rect x="50" y="66" width="8" height="12" rx="3" fill="#16232B" />
		</svg>
	)
}
{
	kind === 'memes' && (
		<svg class="cartoon" viewBox="0 0 88 88" aria-hidden="true">
			<rect x="24" y="18" width="40" height="30" rx="12" fill="#FFE24A" stroke="#16232B" stroke-width="2" />
			<circle cx="36" cy="32" r="3" fill="#16232B" />
			<circle cx="52" cy="32" r="3" fill="#16232B" />
			<path d="M34 42c6 8 14 8 20 0" stroke="#16232B" stroke-width="2" fill="none" />
			<rect x="40" y="12" width="8" height="8" rx="1" fill="#F9FBFC" stroke="#16232B" stroke-width="1.5" />
			<circle cx="44" cy="12" r="3" fill="#D2372C" />
			<rect x="28" y="48" width="32" height="20" rx="4" fill="#F9FBFC" stroke="#16232B" stroke-width="2" />
			<path d="M48 48l8-8 2 6-6 2z" fill="#F9FBFC" stroke="#16232B" stroke-width="1.5" />
			<rect x="18" y="52" width="8" height="12" rx="3" fill="#2A4FD6" stroke="#16232B" stroke-width="1.5" />
			<rect x="62" y="52" width="8" height="12" rx="3" fill="#2A4FD6" stroke="#16232B" stroke-width="1.5" />
			<rect x="32" y="68" width="8" height="10" rx="3" fill="#16232B" />
			<rect x="48" y="68" width="8" height="10" rx="3" fill="#16232B" />
		</svg>
	)
}
{
	kind === 'who' && (
		<svg class="cartoon" viewBox="0 0 88 88" aria-hidden="true">
