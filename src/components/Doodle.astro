			<rect x="52" y="22" width="20" height="16" rx="5" fill="#FFE24A" stroke="#16232B" stroke-width="2" />
			<circle cx="58" cy="30" r="2" fill="#16232B" />
			<circle cx="66" cy="30" r="2" fill="#16232B" />
			<rect x="59" y="16" width="6" height="7" fill="#F9FBFC" stroke="#16232B" stroke-width="1.5" />
			<rect x="50" y="38" width="24" height="16" rx="3" fill="#F9FBFC" stroke="#16232B" stroke-width="2" />
			<rect x="46" y="42" width="6" height="10" rx="2" fill="#D2372C" />
			<rect x="72" y="42" width="6" height="10" rx="2" fill="#D2372C" />
			<rect x="54" y="54" width="6" height="10" rx="2" fill="#16232B" />
			<rect x="64" y="54" width="6" height="10" rx="2" fill="#16232B" />
		</svg>
	)
}
{
	kind === 'walker' && (
		<svg class="sci-bot" viewBox="0 0 64 72" aria-hidden="true">
			<rect x="18" y="10" width="28" height="20" rx="6" fill="#F9FBFC" stroke="#16232B" stroke-width="2" />
			<circle cx="28" cy="20" r="2.5" fill="#2A4FD6" />
			<circle cx="36" cy="20" r="2.5" fill="#2A4FD6" />
			<rect x="30" y="4" width="4" height="8" fill="#D2372C" />
			<rect x="16" y="30" width="32" height="22" rx="4" fill="#FFE24A" stroke="#16232B" stroke-width="2" />
			<rect x="8" y="34" width="8" height="14" rx="3" fill="#F9FBFC" stroke="#16232B" stroke-width="1.5" />
			<rect x="48" y="34" width="8" height="14" rx="3" fill="#F9FBFC" stroke="#16232B" stroke-width="1.5" />
			<rect x="22" y="52" width="7" height="14" rx="3" fill="#16232B" />
			<rect x="35" y="52" width="7" height="14" rx="3" fill="#16232B" />
		</svg>
	)
}
{
	kind === 'sat' && (
		<svg class="sci-bot" viewBox="0 0 72 56" aria-hidden="true">
			<rect x="26" y="18" width="20" height="16" rx="2" fill="#F9FBFC" stroke="#16232B" stroke-width="2" />
			<rect x="4" y="20" width="22" height="12" fill="#2A4FD6" stroke="#16232B" stroke-width="1.5" />
			<rect x="46" y="20" width="22" height="12" fill="#2A4FD6" stroke="#16232B" stroke-width="1.5" />
			<circle cx="36" cy="26" r="3" fill="#D2372C" />
			<line x1="36" y1="18" x2="36" y2="8" stroke="#16232B" stroke-width="2" />
			<circle cx="36" cy="7" r="3" fill="#FFE24A" stroke="#16232B" stroke-width="1.5" />
		</svg>
	)
}
{
	kind === 'rocket' && (
		<svg class="sci-bot" viewBox="0 0 40 72" aria-hidden="true">
			<path d="M20 4c10 10 12 28 12 40H8C8 32 10 14 20 4z" fill="#F9FBFC" stroke="#16232B" stroke-width="2" />
			<circle cx="20" cy="28" r="5" fill="#2A4FD6" stroke="#16232B" stroke-width="1.5" />
			<path d="M8 40l-8 12h16z" fill="#D2372C" stroke="#16232B" stroke-width="1.5" />
			<path d="M32 40l8 12H24z" fill="#D2372C" stroke="#16232B" stroke-width="1.5" />
			<path d="M14 52l6 16 6-16" fill="#FFE24A" stroke="#16232B" stroke-width="1.5" />
		</svg>
	)
}
{
	kind === 'planet' && (
		<svg class="sci-bot" viewBox="0 0 72 56" aria-hidden="true">
			<circle cx="36" cy="28" r="16" fill="#FFE24A" stroke="#16232B" stroke-width="2" />
			<ellipse cx="36" cy="28" rx="30" ry="8" fill="none" stroke="#2A4FD6" stroke-width="2" />
			<circle cx="30" cy="24" r="3" fill="#D2372C" opacity=".7" />
			<circle cx="42" cy="32" r="2" fill="#16232B" opacity=".35" />
		</svg>
	)
}
{
	kind === 'ufo' && (
		<svg class="sci-bot" viewBox="0 0 80 48" aria-hidden="true">
			<ellipse cx="40" cy="22" rx="14" ry="10" fill="#F9FBFC" stroke="#16232B" stroke-width="2" />
			<ellipse cx="40" cy="28" rx="28" ry="10" fill="#2A4FD6" stroke="#16232B" stroke-width="2" />
			<circle cx="28" cy="28" r="2" fill="#FFE24A" />
			<circle cx="40" cy="30" r="2" fill="#FFE24A" />
			<circle cx="52" cy="28" r="2" fill="#FFE24A" />
			<path d="M32 36l-4 10M40 38v10M48 36l4 10" stroke="#D2372C" stroke-width="1.5" />
		</svg>
	)
}
