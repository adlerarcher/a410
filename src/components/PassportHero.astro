---
import { COUNTRY_MARKERS, COUNTRY_REGIONS, flagPngUrl, getGroupedCountries } from '../data/countries';

const count = COUNTRY_MARKERS.length;
const regionCount = COUNTRY_REGIONS.length;
const grouped = getGroupedCountries();

/** One flag per region for the hero mosaic. */
const mosaicFlags = grouped.map(({ region, countries }) => {
	const featured = countries.find((c) => c.flagCode === 'us') ?? countries[0];
	return { region, country: featured };
});
---

<div class="passport-hero relative overflow-hidden px-4 pb-8 pt-2 md:px-6 md:pb-10">
	<div class="passport-hero-mosaic pointer-events-none absolute inset-0" aria-hidden="true">
		{
			mosaicFlags.map(({ country }, i) => (
				<div class="passport-hero-flag" style={`--hero-i: ${i}`}>
					<img
						src={flagPngUrl(country.flagCode)}
						alt=""
						width="120"
						height="80"
						loading="eager"
						decoding="async"
					/>
				</div>
			))
		}
	</div>
	<div class="passport-hero-vignette pointer-events-none absolute inset-0" aria-hidden="true" />
	<div class="relative mx-auto max-w-3xl text-center">
		<p class="font-caveat text-lg text-site-muted md:text-xl">
			<a href="/" class="text-site-gold underline-offset-4 transition-colors hover:underline">
				Home
			</a>
			<span aria-hidden="true"> · </span>
			<span class="text-site-ink">Passport</span>
		</p>
		<h1 class="mt-4 font-caveat text-3xl font-semibold tracking-tight text-site-gold md:text-4xl">
			{count} countries
		</h1>
		<p class="mt-4 font-caveat text-xl leading-relaxed text-site-muted md:text-2xl">
			Places I&apos;ve been able to spend time.
		</p>
		<p class="mt-3 font-mono text-[0.68rem] uppercase tracking-[0.28em] text-site-muted/90 md:text-[0.72rem]">
			{count} places · {regionCount} regions
		</p>
	</div>
</div>

<style>
	.passport-hero-mosaic {
		display: grid;
		place-items: center;
		opacity: 0.38;
		mask-image: radial-gradient(ellipse 85% 70% at 50% 40%, black 20%, transparent 72%);
	}

	.passport-hero-flag {
		position: absolute;
		width: clamp(3.25rem, 7vw, 5rem);
		aspect-ratio: 3 / 2;
		border-radius: 2px;
		overflow: hidden;
		box-shadow:
			0 8px 24px rgba(0, 0, 0, 0.45),
			0 0 0 1px rgba(201, 169, 98, 0.15);
		animation: passport-flag-float-1 9s ease-in-out infinite;
		animation-delay: calc(var(--hero-i) * -0.7s);
	}

	.passport-hero-flag:nth-child(1) {
		left: 10%;
		top: 14%;
		animation-name: passport-flag-float-1;
	}
	.passport-hero-flag:nth-child(2) {
		left: 24%;
		top: 6%;
		animation-name: passport-flag-float-2;
	}
	.passport-hero-flag:nth-child(3) {
		right: 22%;
		top: 10%;
		animation-name: passport-flag-float-3;
	}
	.passport-hero-flag:nth-child(4) {
		right: 8%;
		bottom: 16%;
		animation-name: passport-flag-float-4;
	}

	.passport-hero-flag img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.passport-hero-vignette {
		background: radial-gradient(ellipse 90% 80% at 50% 45%, transparent 35%, var(--color-site-cream) 88%);
	}

	@keyframes passport-flag-float-1 {
		0%,
		100% {
			transform: rotate(-10deg);
		}
		50% {
			transform: rotate(-8deg) translateY(-4px);
		}
	}
	@keyframes passport-flag-float-2 {
		0%,
		100% {
			transform: rotate(-4deg);
		}
		50% {
			transform: rotate(-2deg) translateY(-4px);
		}
	}
	@keyframes passport-flag-float-3 {
		0%,
		100% {
			transform: rotate(5deg);
		}
		50% {
			transform: rotate(7deg) translateY(-4px);
		}
	}
	@keyframes passport-flag-float-4 {
		0%,
		100% {
			transform: rotate(12deg);
		}
		50% {
			transform: rotate(14deg) translateY(-4px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.passport-hero-flag {
			animation: none;
		}
	}
</style>
