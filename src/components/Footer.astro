---
import SocialLinks from './SocialLinks.astro';

interface Props {
	variant?: 'default' | 'workshop';
	transparent?: boolean;
}

const { variant = 'default', transparent = false } = Astro.props;

const year = new Date().getFullYear();

const muted = variant === 'workshop' ? 'text-workshop-muted' : 'text-site-muted';
const brandWordmark = 'font-display text-sm font-semibold tracking-tight text-site-gold';
---

<footer
	class:list={[
		'mt-auto border-t px-6 py-12',
		transparent ? 'border-site-border/50 bg-transparent' : 'border-site-border bg-site-cream',
		variant === 'workshop' ? 'border-workshop-border' : ''
	]}
>
	<div class="mx-auto flex max-w-5xl flex-col items-center gap-6 sm:flex-row sm:justify-between">
		<p class:list={[muted, 'flex flex-wrap items-baseline justify-center gap-x-1 text-sm sm:justify-start']}>
			<span>© {year}</span>
			<span aria-hidden="true">|</span>
			<span class:list={[brandWordmark]}>Adler Archer</span>
			<span aria-hidden="true">·</span>
			<span>helloadler.com</span>
		</p>
		<SocialLinks variant={variant} listClass="justify-center sm:justify-end" />
	</div>
</footer>
