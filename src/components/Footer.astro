---
interface Props {
	transparent?: boolean;
}

const { transparent = false } = Astro.props;
const year = new Date().getFullYear();
---

<footer
	class:list={[
		'mt-auto border-t px-6 py-12',
		transparent ? 'border-site-border/50 bg-transparent' : 'border-site-border bg-site-cream'
	]}
>
	<div class="mx-auto flex max-w-5xl flex-col items-center gap-3 sm:flex-row sm:justify-between">
		<p class="flex flex-wrap items-baseline justify-center gap-x-1 text-sm text-site-muted sm:justify-start">
			<span>© {year}</span>
			<span aria-hidden="true">|</span>
			<span class="font-display text-sm font-semibold tracking-tight text-site-gold">AI410</span>
			<span aria-hidden="true">·</span>
			<span>www.ai410.org</span>
		</p>
		<p class="font-mono text-[10px] uppercase tracking-[0.18em] text-site-muted">
			Clear words. Real understanding.
		</p>
	</div>
</footer>
