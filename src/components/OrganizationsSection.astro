---
import { ORGANIZATIONS, type OrganizationKind } from '../data/organizations';

const kindLabels: Record<OrganizationKind, string> = {
	controlled: 'Controlled entities',
	affiliation: 'Affiliations',
	program: 'Programs'
};

const kinds: OrganizationKind[] = ['controlled', 'affiliation', 'program'];
---

<section
	id="organizations"
	class="scroll-mt-24 border-t border-site-border/70 px-6 py-14 md:py-20"
	aria-labelledby="organizations-heading"
>
	<div class="mx-auto max-w-3xl">
		<h2 id="organizations-heading" class="font-display text-2xl font-semibold text-site-ink md:text-3xl">
			Organizations
		</h2>
		<p class="mt-3 font-serif text-site-muted">Directory of entities, affiliations, and programs in the ecosystem.</p>

		{
			kinds.map((kind) => {
				const entries = ORGANIZATIONS.filter((o) => o.kind === kind);
				if (!entries.length) return null;
				return (
					<div class="mt-10">
						<h3 class="font-mono text-[10px] uppercase tracking-[0.35em] text-site-gold">{kindLabels[kind]}</h3>
						<ul class="mt-5 space-y-5">
							{entries.map((org) => (
								<li class="border-l-2 border-site-border pl-4">
									{
										org.href ? (
											<a
												href={org.href}
												class="font-display text-lg font-medium text-site-ink underline-offset-4 hover:text-site-gold hover:underline"
												{...(org.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
											>
												{org.name}
											</a>
										) : (
											<span class="font-display text-lg font-medium text-site-ink">{org.name}</span>
										)
									}
									<p class="mt-1 font-serif text-sm leading-relaxed text-site-muted">{org.description}</p>
								</li>
							))}
						</ul>
					</div>
				);
			})
		}
	</div>
</section>
