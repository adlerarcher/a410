---
import GatewayGlobe from './GatewayGlobe.astro';

/** Full-screen first paint; Hello Adler globe mark. */
---

<div id="site-loader" class="site-loader" aria-live="polite" aria-busy="true">
	<div class="site-loader__inner">
		<div class="site-loader__stage">
			<span class="site-loader__bloom" aria-hidden="true"></span>
			<span class="site-loader__ring site-loader__ring--a" aria-hidden="true"></span>
			<span class="site-loader__ring site-loader__ring--b" aria-hidden="true"></span>
			<span class="site-loader__ring site-loader__ring--c" aria-hidden="true"></span>
			<span class="site-loader__spark site-loader__spark--1" aria-hidden="true"></span>
			<span class="site-loader__spark site-loader__spark--2" aria-hidden="true"></span>
			<span class="site-loader__spark site-loader__spark--3" aria-hidden="true"></span>
			<span class="site-loader__spark site-loader__spark--4" aria-hidden="true"></span>
			<div class="site-loader__logo-shell">
				<GatewayGlobe size="loader" class="site-loader__globe" />
			</div>
		</div>
	</div>
</div>
<script is:inline>
	(function () {
		var loader = document.getElementById('site-loader');
		if (!loader) return;

		var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		var start = Date.now();
		/* Keep splash visible after load: shorter cap when reduced motion */
		var minMs = reduce ? 480 : 2400;

		function finish() {
			var wait = Math.max(0, minMs - (Date.now() - start));
			window.setTimeout(function () {
				loader.classList.add('site-loader--exit');
				loader.setAttribute('aria-busy', 'false');
				window.setTimeout(function () {
					loader.remove();
				}, 480);
			}, wait);
		}

		if (document.readyState === 'complete') {
			finish();
		} else {
			window.addEventListener('load', finish, { once: true });
		}
	})();
</script>
