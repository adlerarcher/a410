---
import Footer from './Footer.astro';
---

<div class="flex min-h-screen flex-col">
	<header class="border-b border-site-border bg-site-cream/90 px-6 py-5 backdrop-blur-sm">
		<div class="mx-auto flex max-w-5xl justify-center sm:justify-start">
			<a href="/" class="font-display text-xl tracking-tight text-site-ink transition-colors hover:text-site-forest">
				Adler Archer
			</a>
		</div>
	</header>
	<main
		class="flex flex-1 flex-col items-center justify-center px-6 py-16 text-center md:py-24"
		aria-labelledby="uc-heading"
	>
		<p class="text-[0.7rem] font-semibold uppercase tracking-[0.35em] text-site-forest/70">helloadler.com</p>
		<h1
			id="uc-heading"
			class="hero-title-monoton mt-8 max-w-xl text-[clamp(1.5rem,4.5vw,2.75rem)] font-normal leading-tight tracking-[0.04em] md:tracking-[0.06em]"
		>
			Coming soon
		</h1>
		<p class="mt-6 max-w-md font-serif text-lg leading-relaxed text-site-muted md:text-xl">
			This gateway is being finished. Thank you for your patience.
		</p>
		<p class="mt-4 font-sans text-sm text-site-muted">
			<a class="font-medium text-site-forest underline-offset-4 transition-colors hover:underline" href="/#start">
				Start here
			</a>
		</p>
	</main>
	<Footer />
</div>
