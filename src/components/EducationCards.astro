---
import type { DegreeEntry } from '../data/education';
import {
	EDUCATION_DOCTORATE,
	EDUCATION_MASTERS,
	EDUCATION_GRADUATE_CERTIFICATE,
	EDUCATION_UNDERGRADUATE
} from '../data/education';

interface Props {
	doctorate?: DegreeEntry[];
	masters?: DegreeEntry[];
	graduateCertificate?: DegreeEntry[];
	undergraduate?: DegreeEntry[];
}

const doctorate = Astro.props.doctorate ?? EDUCATION_DOCTORATE;
const masters = Astro.props.masters ?? EDUCATION_MASTERS;
const graduateCertificate = Astro.props.graduateCertificate ?? EDUCATION_GRADUATE_CERTIFICATE;
const undergraduate = Astro.props.undergraduate ?? EDUCATION_UNDERGRADUATE;

const rows: { label: string | readonly [string, string]; items: DegreeEntry[]; gridClass: string }[] = [
	{
		label: ['doctoral', 'degree'],
		items: doctorate,
		gridClass: 'grid-cols-1 sm:grid-cols-2 gap-4 md:gap-5 max-w-4xl'
	},
	{
		label: ["master's", 'degrees'],
		items: masters,
		gridClass: 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-5'
	},
	{
		label: 'Graduate certificate',
		items: graduateCertificate,
		gridClass: 'grid-cols-1 gap-4 md:gap-5 max-w-md'
	},
	{
		label: 'Undergraduate degrees',
		items: undergraduate,
		gridClass: 'grid-cols-1 sm:grid-cols-2 gap-4 md:gap-5 max-w-4xl'
	}
];
const credentialCount =
	doctorate.length + masters.length + graduateCertificate.length + undergraduate.length;
---

<section class="education-section mx-auto max-w-6xl px-4 pb-20 pt-4 md:px-6 md:pb-28" aria-labelledby="education-heading">
	<h2
		id="education-heading"
		class="text-center font-display text-3xl font-semibold tracking-tight text-site-gold md:text-4xl"
	>
		Education
	</h2>
	<div class="mx-auto mt-6 flex items-center justify-center gap-2.5 md:mt-7">
		<span class="h-px w-8 bg-gradient-to-r from-transparent to-foundation-gold/70" aria-hidden="true"></span>
		<p class="max-w-[min(100%,20rem)] text-center font-mono text-[10px] uppercase leading-relaxed tracking-[0.35em] text-warm-gray/90 md:max-w-none">
			{credentialCount} credentials across law, medicine, business &amp; technology
		</p>
		<span class="h-px w-8 bg-gradient-to-l from-transparent to-foundation-gold/70" aria-hidden="true"></span>
	</div>
	<div class="mt-10 space-y-12 md:space-y-14">
		{
			rows.map(({ label, items, gridClass }) => (
				<div class="education-row flex flex-row items-start gap-4 sm:gap-8 md:gap-10">
					<h3 class="education-row-label w-[6.75rem] shrink-0 pt-0.5 text-right font-sans text-[0.65rem] font-semibold uppercase leading-snug tracking-[0.32em] text-site-muted sm:w-[9.5rem] sm:text-[0.7rem] sm:tracking-[0.38em] md:w-44 md:pt-1">
						{Array.isArray(label) ? (
							<>
								{label[0]}
								<br />
								{label[1]}
							</>
						) : (
							label
						)}
					</h3>
					<ul class:list={['grid min-w-0 flex-1 list-none', gridClass]} role="list">
						{items.map((d) => (
							<li class="group">
								<div
									class:list={[
										'education-card-frame',
										d.credential === 'JD' && 'education-card-frame--jd',
										d.credential === 'AAS' && 'education-card-frame--aas'
									]}
								>
									<div class="education-card-inner">
										<div class="education-card-shine" aria-hidden="true" />
										<div class="education-card-topbar" aria-hidden="true" />
										{d.credential === 'JD' && (
											<img
												src="/images/education/legal-scales-icon.svg"
												alt=""
												width="40"
												height="40"
												loading="lazy"
												decoding="async"
												class="education-card-icon"
												aria-hidden="true"
											/>
										)}
										{d.credential === 'AAS' && (
											<img
												src="/images/us-air-force-logo.svg"
												alt=""
												width="80"
												height="62"
												loading="lazy"
												decoding="async"
												class="education-card-icon education-card-icon--military"
												aria-hidden="true"
											/>
										)}
										{d.credential === 'MS' && d.institution === 'Johns Hopkins Medicine' && (
											<img
												src="/images/education/rod-asclepius-icon.svg"
												alt=""
												width="40"
												height="40"
												loading="lazy"
												decoding="async"
												class="education-card-icon"
												aria-hidden="true"
											/>
										)}
										{d.credential === 'MSc' && d.institution === "King's College London" && (
											<img
												src="/images/education/brain-icon.svg"
												alt=""
												width="40"
												height="40"
												loading="lazy"
												decoding="async"
												class="education-card-icon"
												aria-hidden="true"
											/>
										)}
										{d.credential === 'MA' && d.institution === 'University of Denver' && (
											<img
												src="/images/education/microphone-icon.svg"
												alt=""
												width="40"
												height="40"
												loading="lazy"
												decoding="async"
												class="education-card-icon"
												aria-hidden="true"
											/>
										)}
										{d.credential === 'Graduate Certificate' && d.institution.includes('Carey') && (
											<img
												src="/images/education/briefcase-icon.svg"
												alt=""
												width="40"
												height="40"
												loading="lazy"
												decoding="async"
												class="education-card-icon"
												aria-hidden="true"
											/>
										)}
										{d.credential === 'BA' && d.institution === 'Columbia College' && (
											<img
												src="/images/education/graduation-cap-icon.svg"
												alt=""
												width="40"
												height="40"
												loading="lazy"
												decoding="async"
												class="education-card-icon"
												aria-hidden="true"
											/>
										)}
										<p class="font-display text-lg font-semibold leading-tight text-site-gold md:text-xl">{d.credential}</p>
										{d.field && (
											<p class="font-serif text-[0.88rem] leading-relaxed text-site-ink md:text-[0.92rem]">{d.field}</p>
										)}
										<p class="mt-auto font-serif text-[0.88rem] leading-relaxed text-site-muted md:text-[0.92rem]">
											{d.institution}
										</p>
									</div>
								</div>
							</li>
						))}
					</ul>
				</div>
			))
		}
	</div>
</section>

<style>
	.education-row-label {
		text-shadow: 0 0 28px rgba(201, 169, 98, 0.12);
	}

	.education-card-frame {
		position: relative;
		border-radius: 0.125rem;
		padding: 1px;
		background: linear-gradient(
			145deg,
			rgba(201, 169, 98, 0.55) 0%,
			rgba(201, 169, 98, 0.12) 35%,
			rgba(107, 45, 58, 0.25) 70%,
			rgba(201, 169, 98, 0.2) 100%
		);
		box-shadow:
			0 4px 24px rgba(0, 0, 0, 0.45),
			0 0 0 1px rgba(201, 169, 98, 0.08),
			inset 0 1px 0 rgba(255, 255, 255, 0.05);
		transition:
			box-shadow 0.45s cubic-bezier(0.22, 1, 0.36, 1),
			transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.group:hover .education-card-frame {
		box-shadow:
			0 12px 48px -8px rgba(0, 0, 0, 0.55),
			0 0 40px -4px rgba(201, 169, 98, 0.22),
			0 0 72px -12px rgba(201, 169, 98, 0.12),
			inset 0 1px 0 rgba(255, 255, 255, 0.08);
		transform: translateY(-3px);
	}

	.education-card-icon {
		pointer-events: none;
		position: absolute;
		top: 0.55rem;
		right: 0.55rem;
		z-index: 2;
		height: 1.65rem;
		width: 1.65rem;
		object-fit: contain;
		opacity: 0.52;
	}

	@media (min-width: 768px) {
		.education-card-icon {
			top: 0.65rem;
			right: 0.65rem;
			height: 1.85rem;
			width: 1.85rem;
		}
	}

	.education-card-icon--military {
		opacity: 0.62;
		filter: brightness(1.15) saturate(0.85);
	}

	.education-card-inner {
		position: relative;
		display: flex;
		height: 100%;
		min-height: 100%;
		flex-direction: column;
		gap: 0.5rem;
		overflow: hidden;
		border-radius: 0.0625rem;
		background: linear-gradient(165deg, rgba(20, 18, 16, 0.96) 0%, rgba(12, 11, 9, 0.98) 45%, rgba(18, 16, 14, 0.95) 100%);
		padding: 1.25rem 1.35rem;
	}

	@media (min-width: 768px) {
		.education-card-inner {
			padding: 1.4rem 1.5rem;
		}
	}

	.education-card-topbar {
		position: absolute;
		left: 0;
		right: 0;
		top: 0;
		height: 2px;
		background: linear-gradient(
			90deg,
			transparent,
			rgba(201, 169, 98, 0.55) 20%,
			rgba(201, 169, 98, 0.85) 50%,
			rgba(201, 169, 98, 0.55) 80%,
			transparent
		);
		opacity: 0.9;
	}

	.education-card-shine {
		pointer-events: none;
		position: absolute;
		inset: -40% -30% auto auto;
		width: 70%;
		height: 120%;
		background: linear-gradient(
			115deg,
			transparent 0%,
			transparent 42%,
			rgba(201, 169, 98, 0.07) 50%,
			transparent 58%,
			transparent 100%
		);
		transform: translateX(0) skewX(-12deg);
		transition: opacity 0.5s ease;
		opacity: 0.65;
	}

	.group:hover .education-card-shine {
		opacity: 1;
		animation: education-shine-sweep 2.2s ease-in-out infinite;
	}

	@keyframes education-shine-sweep {
		0%,
		100% {
			transform: translateX(-8%) skewX(-12deg);
		}
		50% {
			transform: translateX(12%) skewX(-12deg);
		}
	}

	/* JD card: slow, formal sway */
	.education-card-frame--jd .education-card-inner {
		animation: education-jd-sway 5s ease-in-out infinite;
		transform-origin: 50% 8%;
		will-change: transform;
	}

	@keyframes education-jd-sway {
		0%,
		100% {
			transform: rotate(-0.45deg);
		}
		50% {
			transform: rotate(0.45deg);
		}
	}

	/* AAS card: tight technical drift */
	.education-card-frame--aas .education-card-inner {
		animation: education-aas-drift 2.9s ease-in-out infinite;
		will-change: transform, filter;
	}

	@keyframes education-aas-drift {
		0%,
		100% {
			transform: translateX(0) translateY(0);
			filter: brightness(1);
		}
		33% {
			transform: translateX(2px) translateY(-1px);
			filter: brightness(1.035);
		}
		66% {
			transform: translateX(-2px) translateY(0);
			filter: brightness(1.02);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.group:hover .education-card-frame {
			transform: none;
		}
		.group:hover .education-card-shine {
			animation: none;
		}

		.education-card-frame--jd .education-card-inner,
		.education-card-frame--aas .education-card-inner {
			animation: none;
			filter: none;
		}
	}
</style>
