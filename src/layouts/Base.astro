---
import '../styles/global.css';
import {
	PERSON_PRIMARY_URL,
	SITE_DEFAULT_DESCRIPTION,
	SITE_KEYWORDS,
	SITE_NAME,
	SITE_OG_IMAGE,
	SITE_PERSON_NAME,
	SITE_TAGLINE
} from '../data/site-meta';
import {
	absoluteUrl,
	buildPersonSchema,
	buildWebsiteSchema
} from '../data/seo';

interface Props {
	title: string;
	description?: string;
	ogImage?: string;
	/** Extra JSON-LD nodes merged into @graph (Person + WebSite always included). */
	jsonLdExtra?: Record<string, unknown>[];
	noindex?: boolean;
}

const {
	title,
	description = SITE_DEFAULT_DESCRIPTION,
	ogImage = SITE_OG_IMAGE,
	jsonLdExtra = [],
	noindex = false
} = Astro.props;

const year = new Date().getFullYear();
const path = Astro.url.pathname;
const onHome = path === '/';
const onWho = path.startsWith('/who');
const onWords = path.startsWith('/glossary');
const onLessons = path.startsWith('/lessons');
const onMemes = path.startsWith('/memes');

const siteOrigin = (Astro.site ?? new URL('https://www.ai410.org')).origin;
const canonicalURL = new URL(path, siteOrigin);
const ogImageURL = absoluteUrl(ogImage, siteOrigin);

const pageTitle =
	title === SITE_NAME || title.endsWith(` · ${SITE_NAME}`) || title.includes('AI410')
		? title
		: `${title} · ${SITE_NAME}`;

const schemaGraph = {
	'@context': 'https://schema.org',
	'@graph': [
		buildWebsiteSchema(siteOrigin, description),
		buildPersonSchema(siteOrigin),
		...jsonLdExtra
	]
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <meta name="author" content={SITE_PERSON_NAME} />
  <meta name="keywords" content={SITE_KEYWORDS} />
  <meta name="creator" content={SITE_PERSON_NAME} />
  <meta name="publisher" content={`${SITE_NAME} by ${SITE_PERSON_NAME}`} />
  {noindex ? (
    <meta name="robots" content="noindex, nofollow" />
  ) : (
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  )}
  <link rel="canonical" href={canonicalURL.href} />
  <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" title="Sitemap" />
  <link rel="icon" type="image/svg+xml" href="/images/ai410-mark.svg" />
  <link rel="apple-touch-icon" href="/images/ai410-mark.svg" />
  <link rel="me" href={PERSON_PRIMARY_URL} />
  <link rel="me" href="https://www.linkedin.com/in/adlerarcher" />
  <link rel="author" href={`${siteOrigin}/who/`} />
  <link rel="author" href={PERSON_PRIMARY_URL} />
  <meta property="og:type" content={onWho ? 'profile' : 'website'} />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL.href} />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:image:alt" content={`${SITE_NAME}: ${SITE_TAGLINE} by ${SITE_PERSON_NAME}`} />
  <meta property="og:locale" content="en_US" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />
  <meta name="twitter:label1" content="Written by" />
  <meta name="twitter:data1" content={SITE_PERSON_NAME} />
  <meta name="twitter:label2" content="Topic" />
  <meta name="twitter:data2" content="Artificial intelligence" />
  {!noindex && (
    <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
  )}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,800&family=Caveat:wght@600;700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body class:list={[onHome && 'home', onMemes && 'memes']}>
  <div class="wrap">
    <div class="topline">
      <a class:list={['homechip', onHome && 'is-on']} href="/" aria-label="AI410 home, artificial intelligence by Adler Archer">
        <img src="/images/ai410-mark.svg" alt="" width="28" height="28" />
        ai410
      </a>
      <nav class="menu" aria-label="Site">
        <a
          class:list={['tab', 'tab-a', onLessons && 'is-on']}
          href="/lessons/"
          aria-current={onLessons ? 'page' : undefined}
        >
          <span class="tab-mark" aria-hidden="true">★</span>
          Lessons
        </a>
        <a
          class:list={['tab', 'tab-b', onWords && 'is-on']}
          href="/glossary/"
          aria-current={onWords ? 'page' : undefined}
        >
          <span class="tab-mark" aria-hidden="true">abc</span>
          Words
        </a>
        <a
          class:list={['tab', 'tab-d', onMemes && 'is-on']}
          href="/memes/"
          aria-current={onMemes ? 'page' : undefined}
        >
          <span class="tab-mark" aria-hidden="true">ha</span>
          Memes
        </a>
        <a
          class:list={['tab', 'tab-c', onWho && 'is-on']}
          href="/who/"
          aria-current={onWho ? 'page' : undefined}
        >
          <span class="tab-mark" aria-hidden="true">→</span>
          Who wrote this
        </a>
      </nav>
    </div>
    <slot />
    <footer>
      <nav class="footer-nav" aria-label="Footer">
        <a href="/lessons/">Lessons</a>
        <a href="/glossary/">Glossary</a>
        <a href="/memes/">Memes</a>
        <a href="/who/">Who wrote this</a>
        <a href={PERSON_PRIMARY_URL} rel="me author">Adler Archer</a>
      </nav>
      <p class="footer-copyright">
        © {year} {SITE_PERSON_NAME}. {SITE_NAME}: plain-language artificial intelligence.
      </p>
    </footer>
  </div>

  <script is:inline>
    (function () {
      var KEY = 'ai410-mode';
      var VIEW = 'ai410-view';
      var stored = null;
      var storedView = null;
      try {
        stored = window.localStorage.getItem(KEY);
        storedView = window.localStorage.getItem(VIEW);
      } catch (e) {}
      var grown = stored === 'grown';
      var cards = storedView === 'cards';

      function paint(animate) {
        var swaps = document.querySelectorAll('.swap');
        function apply() {
          swaps.forEach(function (el) {
            var next = grown ? el.dataset.grown : el.dataset.kid;
            if (next) el.textContent = next;
          });
          document.body.classList.toggle('grown-mode', grown);
          document.body.classList.remove('swapping');
        }
        if (animate) {
          document.body.classList.add('swapping');
          setTimeout(apply, 160);
        } else {
          apply();
        }
      }

      function wire() {
        var btn = document.getElementById('toggle');
        if (btn) {
          btn.setAttribute('aria-pressed', String(grown));
          btn.addEventListener('click', function () {
            grown = !grown;
            btn.setAttribute('aria-pressed', String(grown));
            try { window.localStorage.setItem(KEY, grown ? 'grown' : 'kid'); } catch (e) {}
            paint(true);
          });
        }
        if (grown) paint(false);

        var viewBtn = document.getElementById('view');
        if (viewBtn) {
          viewBtn.setAttribute('aria-pressed', String(cards));
          document.body.classList.toggle('cards-on', cards);
          viewBtn.addEventListener('click', function () {
            cards = !cards;
            viewBtn.setAttribute('aria-pressed', String(cards));
            document.body.classList.toggle('cards-on', cards);
            try { window.localStorage.setItem(VIEW, cards ? 'cards' : 'list'); } catch (e) {}
          });
        }

        document.querySelectorAll('[data-flash]').forEach(function (card) {
          function flip() {
            var on = card.classList.toggle('is-flipped');
            card.setAttribute('aria-pressed', String(on));
          }
          card.addEventListener('click', function (e) {
            if (e.target.closest('a')) return;
            flip();
          });
          card.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              flip();
            }
          });
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', wire);
      } else {
        wire();
      }
    })();
  </script>
</body>
</html>
