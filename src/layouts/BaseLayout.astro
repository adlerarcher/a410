---
import '../styles/global.css';
import { siteUnderConstruction } from '../site-flags';
import {
	SITE_DEFAULT_DESCRIPTION,
	SITE_NAME,
	SITE_OG_IMAGE,
	SITE_TAGLINE
} from '../data/site-meta';

interface Props {
	title: string;
	description?: string;
	/** Open Graph / Twitter image path from site root (absolute URL built at deploy). */
	ogImage?: string;
	/**
	 * When true, emit noindex. Defaults to `siteUnderConstruction` so coming-soon builds stay out of search.
	 */
	noindex?: boolean;
	/** Emit WebSite JSON-LD (default: true). */
	jsonLd?: boolean;
}

const {
	title,
	description = SITE_DEFAULT_DESCRIPTION,
	ogImage = SITE_OG_IMAGE,
	noindex: noindexProp,
	jsonLd = true
} = Astro.props;

const noindex = noindexProp !== undefined ? noindexProp : siteUnderConstruction;

const siteOrigin = (Astro.site ?? new URL('https://www.ai410.org')).origin;
const canonicalURL = new URL(Astro.url.pathname, siteOrigin);
const ogImageURL = new URL(ogImage.startsWith('/') ? ogImage : `/${ogImage}`, siteOrigin).href;

const siteName = SITE_NAME;
const pageTitle =
	title === siteName || title.endsWith(` · ${siteName}`) ? title : `${title} · ${siteName}`;

const schemaGraph = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebSite',
			'@id': `${siteOrigin}/#website`,
			url: `${siteOrigin}/`,
			name: siteName,
			alternateName: [SITE_TAGLINE, 'ai410.org'],
			description,
			inLanguage: 'en-US'
		}
	]
};

const fontHref =
	'https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@9..144,300;9..144,400;9..144,600&family=JetBrains+Mono:wght@400&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/images/ai410-mark.svg" />
		<link rel="apple-touch-icon" href="/images/ai410-mark.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex" />}
		<link rel="canonical" href={canonicalURL.href} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" title="Sitemap" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL.href} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:alt" content={`${SITE_NAME} — ${SITE_TAGLINE}`} />
		<meta property="og:locale" content="en_US" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />
		<title>{pageTitle}</title>
		{jsonLd && !noindex && (
			<script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
		)}
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href={fontHref} rel="stylesheet" />
	</head>
	<body class="site-shell min-h-screen">
		<slot />
	</body>
</html>
