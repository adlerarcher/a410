---
import '../styles/global.css';
import { siteUnderConstruction } from '../site-flags';
import {
	SITE_DEFAULT_DESCRIPTION,
	SITE_NAME,
	SITE_OG_IMAGE,
	SITE_TAGLINE
} from '../data/site-meta';

interface Props {
	title: string;
	description?: string;
	/** Open Graph / Twitter image path from site root (absolute URL built at deploy). */
	ogImage?: string;
	/**
	 * When true, emit noindex. Defaults to `siteUnderConstruction` so coming-soon builds stay out of search.
	 */
	noindex?: boolean;
	/** Emit WebSite JSON-LD (default: true). */
	jsonLd?: boolean;
}

const {
	title,
	description = SITE_DEFAULT_DESCRIPTION,
	ogImage = SITE_OG_IMAGE,
	noindex: noindexProp,
	jsonLd = true
} = Astro.props;

const noindex = noindexProp !== undefined ? noindexProp : siteUnderConstruction;

const siteOrigin = (Astro.site ?? new URL('https://www.ai410.org')).origin;
const canonicalURL = new URL(Astro.url.pathname, siteOrigin);
const ogImageURL = new URL(ogImage.startsWith('/') ? ogImage : `/${ogImage}`, siteOrigin).href;

const siteName = SITE_NAME;
const pageTitle =
	title === siteName || title.endsWith(` · ${siteName}`) ? title : `${title} · ${siteName}`;

const schemaGraph = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebSite',
			'@id': `${siteOrigin}/#website`,
			url: `${siteOrigin}/`,
			name: siteName,
			alternateName: [SITE_TAGLINE, 'ai410.org'],
			description,
			inLanguage: 'en-US'
		}
	]
};

const fontHref =
	'https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,800&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=DM+Mono:wght@400;500&display=swap';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/images/ai410-mark.svg" />
		<link rel="apple-touch-icon" href="/images/ai410-mark.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex" />}
		<link rel="canonical" href={canonicalURL.href} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" title="Sitemap" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL.href} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:alt" content={`${SITE_NAME} — ${SITE_TAGLINE}`} />
		<meta property="og:locale" content="en_US" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />
		<title>{pageTitle}</title>
		{jsonLd && !noindex && (
			<script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
		)}
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href={fontHref} rel="stylesheet" />
	</head>
	<body>
		<slot />
		<script is:inline>
			(function () {
				var KEY = 'ai410-mode';
				var stored = null;
				try {
					stored = window.localStorage.getItem(KEY);
				} catch (e) {}
				var grown = stored === 'grown';

				function paint(animate) {
					var swaps = document.querySelectorAll('.swap');
					function apply() {
						swaps.forEach(function (el) {
							var next = grown ? el.dataset.grown : el.dataset.kid;
							if (next) el.textContent = next;
						});
						document.body.classList.toggle('grown-mode', grown);
						document.body.classList.remove('swapping');
					}
					if (animate) {
						document.body.classList.add('swapping');
						setTimeout(apply, 160);
					} else {
						apply();
					}
				}

				function wire() {
					var btn = document.getElementById('toggle');
					if (btn) {
						btn.setAttribute('aria-pressed', String(grown));
						btn.addEventListener('click', function () {
							grown = !grown;
							btn.setAttribute('aria-pressed', String(grown));
							try {
								window.localStorage.setItem(KEY, grown ? 'grown' : 'kid');
							} catch (e) {}
							paint(true);
						});
					}
					if (grown) paint(false);
				}

				if (document.readyState === 'loading') {
					document.addEventListener('DOMContentLoaded', wire);
				} else {
					wire();
				}
			})();
		</script>
	</body>
</html>
