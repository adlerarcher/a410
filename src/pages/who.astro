---
import Base from '../layouts/Base.astro';
import {
	PERSON_PRIMARY_URL,
	SITE_PERSON_NAME,
	SITE_PERSON_NAME_FULL
} from '../data/site-meta';
import { absoluteUrl, buildBreadcrumbSchema } from '../data/seo';

const description =
	'Adler Archer — author of AI410 — explains artificial intelligence in plain language. Presidential Innovation Fellow at the U.S. Department of Energy; faculty at Johns Hopkins School of Medicine.';

const siteOrigin = (Astro.site ?? new URL('https://www.ai410.org')).origin;
const jsonLdExtra = [
	buildBreadcrumbSchema(siteOrigin, [
		{ name: 'AI410', path: '/' },
		{ name: 'Who wrote this', path: '/who/' }
	]),
	{
		'@type': 'ProfilePage',
		'@id': absoluteUrl('/who/', siteOrigin),
		url: absoluteUrl('/who/', siteOrigin),
		name: `Who wrote this — ${SITE_PERSON_NAME}`,
		description,
		mainEntity: { '@id': `${siteOrigin}/#person` },
		about: [
			{ '@type': 'Person', name: SITE_PERSON_NAME },
			{ '@type': 'Thing', name: 'artificial intelligence' }
		],
		isPartOf: { '@id': `${siteOrigin}/#website` }
	}
];
---
<Base title={`Who wrote this — ${SITE_PERSON_NAME} · AI410`} description={description} jsonLdExtra={jsonLdExtra}>
  <header class="masthead compact">
    <p class="tag"><a href="/">ai410.org</a> &nbsp;/&nbsp; Who wrote this</p>
    <h1>Who wrote this</h1>
    <p class="dek">
      I am {SITE_PERSON_NAME}. I write plain-language artificial intelligence explanations on AI410
      and build with these systems in federal permitting work.
    </p>
  </header>

  <main class="lesson-body">
    <figure class="portrait">
      <img src="/images/adler-archer-cartoon.png" alt={`Portrait illustration of ${SITE_PERSON_NAME}`} width="1024" height="1024" />
      <figcaption>{SITE_PERSON_NAME_FULL}</figcaption>
    </figure>

    <p>
      I work on energy and technology at the U.S. Department of Energy as a Presidential Innovation Fellow,
      and I teach at Johns Hopkins School of Medicine. The work is a place where a fluent sentence and a real
      record are not the same object, and where looking something up is not the same as filing it. That difference
      is what these artificial intelligence notes are for.
    </p>
    <p>
      Each AI410 lesson has two versions: small words, and the terms you will see elsewhere. The small-words
      version is how I check the idea is actually in hand. It is a method, not a claim about the reader's age.
    </p>
    <p>
      I was born in the Deep South and raised in Japan. I come from a military family and enlisted in the Air Force
      at seventeen. My work since then has moved through aerospace, law, health systems, and public service. A
      question I keep coming back to is how a person stays effective as life gets larger and more complicated. I
      read a lot. I write when I have thought something through.
    </p>
    <p>
      Away from the desk I hike, visit parks, travel, cook, lift, and sit still when I can. Those habits, plus a
      bookshelf, live on my writing site.
    </p>
    <ul class="interest-row">
      <li>Hiking</li>
      <li>Parks</li>
      <li>Travel</li>
      <li>Yoga</li>
      <li>Sushi</li>
      <li>Cars</li>
      <li>Wine</li>
      <li>Board games</li>
    </ul>
    <p>This is personal writing about artificial intelligence. It is not an official government publication.</p>

    <div class="contents outbound">
      <a class="entry hand" href={PERSON_PRIMARY_URL} rel="me author">
        <span class="num">→</span>
        <div>
          <h2>adlerarcher.com</h2>
          <p>Essays, notes, bookshelf, parks, and passport by Adler Archer.</p>
        </div>
      </a>
      <a class="entry hand" href="https://helloadler.com/" rel="me">
        <span class="num">→</span>
        <div>
          <h2>helloadler.com</h2>
          <p>Gateway to Adler Archer affiliations, entities, and writing.</p>
        </div>
      </a>
    </div>
  </main>
</Base>
