---
import Base from '../../layouts/Base.astro';
import {
	absoluteUrl,
	buildBreadcrumbSchema,
	buildLearningResourceSchema
} from '../../data/seo';

export async function getStaticPaths() {
  const modules = import.meta.glob('../../data/lessons/*.json', { eager: true });
  const lessons = Object.values(modules)
    .map((m) => m.default ?? m)
    .sort((a, b) => a.number.localeCompare(b.number));

  return lessons.map((lesson, i) => ({
    params: { slug: lesson.slug },
    props: {
      lesson,
      prev: lessons[i - 1] ?? null,
      next: lessons[i + 1] ?? null
    }
  }));
}

const { lesson, prev, next } = Astro.props;
const siteOrigin = (Astro.site ?? new URL('https://www.ai410.org')).origin;
const lessonPath = `/lessons/${lesson.slug}/`;
const lessonUrl = absoluteUrl(lessonPath, siteOrigin);
const description = `${lesson.blurb} A plain-language artificial intelligence lesson by Adler Archer on AI410.`;
const title = `${lesson.title}: AI lesson by Adler Archer · AI410`;
const jsonLdExtra = [
	buildBreadcrumbSchema(siteOrigin, [
		{ name: 'AI410', path: '/' },
		{ name: 'Lessons', path: '/lessons/' },
		{ name: lesson.title, path: lessonPath }
	]),
	buildLearningResourceSchema({
		siteOrigin,
		url: lessonUrl,
		title: lesson.title,
		description
	})
];
---
<Base title={title} description={description} jsonLdExtra={jsonLdExtra}>
  <header class="masthead compact">
    <p class="tag"><a href="/lessons/">Lessons</a> &nbsp;/&nbsp; Lesson {lesson.number}</p>
    <h1>{lesson.title}</h1>
    <p class="dek">Artificial intelligence · by <a href="/who/">Adler Archer</a></p>

    <div class="switch">
      <p>Version</p>
      <button class="toggle" id="toggle" aria-pressed="false">
        <span data-on="kid">Plain words</span><span data-on="grown">Technical</span>
      </button>
    </div>
  </header>

  <main class="lesson-body">
    {lesson.paras.map((p) => (
      <p class="swap" data-kid={p.kid} data-grown={p.grown}>{p.kid}</p>
    ))}

    <nav class="pager">
      {prev && (
        <a class="prev" href={`/lessons/${prev.slug}/`}>
          <span>Back</span>{prev.title}
        </a>
      )}
      {next && (
        <a class="next" href={`/lessons/${next.slug}/`}>
          <span>Next</span>{next.title}
        </a>
      )}
    </nav>
  </main>
</Base>
