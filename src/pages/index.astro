---
import Base from '../layouts/Base.astro';
import Doodle from '../components/Doodle.astro';
import { SITE_DEFAULT_DESCRIPTION, SITE_HOME_TITLE } from '../data/site-meta';

const pages = [
	{
		href: '/lessons/',
		title: 'Lessons',
		blurb: 'What it knows, what it can read, what it can do.',
		kind: 'lessons' as const
	},
	{
		href: '/glossary/',
		title: 'Words',
		blurb: 'The terms that show up when you try to see how it works.',
		kind: 'words' as const
	},
	{
		href: '/memes/',
		title: 'Memes',
		blurb: 'The same distinctions. Less patient.',
		kind: 'memes' as const
	},
	{
		href: 'https://adlerarcher.com/',
		title: 'adlerarcher.com',
		blurb: 'Essays, notes, bookshelf, parks, and passport.',
		kind: 'adler' as const
	}
];
---
<Base title={`AI410 | ${SITE_HOME_TITLE}`} description={SITE_DEFAULT_DESCRIPTION}>
	<header class="masthead home-hero">
		<div class="home-stage" aria-hidden="true">
			<span class="orbit orbit-a"></span>
			<span class="orbit orbit-b"></span>
			<span class="orbit orbit-c"></span>
			<span class="sci sci-walk float-a"><Doodle kind="walker" /></span>
			<span class="sci sci-sat float-b"><Doodle kind="sat" /></span>
			<span class="sci sci-rocket float-c"><Doodle kind="rocket" /></span>
			<span class="sci sci-planet float-d"><Doodle kind="planet" /></span>
			<span class="sci sci-ufo float-e"><Doodle kind="ufo" /></span>
			<span class="scrap scrap-sticky scrap-3 float-c">10</span>
			<span class="doodle doodle-star">★</span>
			<span class="doodle doodle-star doodle-star-2">★</span>
			<span class="doodle doodle-star doodle-star-3">✦</span>
			<svg class="doodle doodle-scribble" viewBox="0 0 120 36" fill="none">
				<path d="M4 22c18-16 28 14 46 2 16-10 22 12 42-4 12-10 22 6 24 8" />
			</svg>
		</div>

		<div class="hero-copy">
			<p class="kicker reveal">ai410</p>
			<h1 class="reveal delay-1">How AI systems <span class="flip">actually work</span>.</h1>
			<p class="byline reveal delay-2">By <a href="/who/">Adler Archer</a></p>
			<p class="dek reveal delay-3">
				Plain-language explanations of the parts that matter, written by someone who builds with
				these systems in federal permitting.
			</p>
		</div>

		<div class="home-deck reveal delay-4">
			{pages.map((page) => (
				<article
					class:list={['flash', 'home-flash', page.kind === 'adler' && 'adler-flash']}
					data-flash
					tabindex="0"
					role="button"
					aria-pressed="false"
					aria-label={`${page.title}. Flip for a line, or open the page.`}
				>
					<div class="flash-inner">
						<div class="flash-face flash-front">
							{page.kind === 'adler' ? (
								<img
									class="home-portrait"
									src="/images/adler-archer-cartoon.png"
									alt=""
									width="1024"
									height="1024"
								/>
							) : (
								<Doodle kind={page.kind} />
							)}
							<h2>{page.title}</h2>
							<p class="flash-hint">Flip</p>
						</div>
						<div class="flash-face flash-back">
							<p>{page.blurb}</p>
						</div>
					</div>
					<a
						class="flash-open"
						href={page.href}
						rel={page.kind === 'adler' ? 'me' : undefined}
					>
						Open
					</a>
				</article>
			))}
		</div>
	</header>
</Base>
